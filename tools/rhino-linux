#!/usr/bin/env bash
# rhino-linux — Launch and control Rhinoceros under Wine with optimized X11/DXVK settings.
#
# Usage:
#   rhino-linux            open the newest installed Rhino
#   rhino-linux <file...>  open .3dm models or supported CAD files (Linux or Windows paths)
#   rhino-linux --version 8  open Rhino 8 (also: rhino-8, or RHINO_VERSION=8)
#   rhino-7, rhino-8, rhino-9  open that version; rhino-9 opens the newest
#                          when Rhino 9 is not installed (it was the only command before 1.2)
#   rhino-linux --fresh    restart wineserver before launch for clean state
#   rhino-linux --stop     stop Rhino (every installed version, or the one given)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Explicit environment variables take precedence over saved config
ENV_PREFIX="${RHINO_PREFIX:-${WINEPREFIX:-}}"

# Locate companion asset directory
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/rhino-linux"
find_asset() {
    local name="$1"
    if [ -f "$DATA_DIR/$name" ]; then
        echo "$DATA_DIR/$name"
    elif [ -f "$SCRIPT_DIR/$name" ]; then
        echo "$SCRIPT_DIR/$name"
    elif [ -f "$SCRIPT_DIR/tools/$name" ]; then
        echo "$SCRIPT_DIR/tools/$name"
    elif [ -f "$SCRIPT_DIR/../tools/$name" ]; then
        echo "$SCRIPT_DIR/../tools/$name"
    fi
}

# Rhino versions and their prefixes (find_rhino_dir, rhino_prefix_for, ...)
versions_lib="$(find_asset rhino-versions.sh)"
if [ -z "$versions_lib" ]; then
    echo "error: rhino-versions.sh not found next to $0 or in $DATA_DIR" >&2
    exit 1
fi
# shellcheck source=rhino-versions.sh
. "$versions_lib"

# Which Rhino: rhino-7 / rhino-8 / rhino-9 by name, --version N, or RHINO_VERSION.
REQ_VERSION="${RHINO_VERSION:-}"
NAME_VERSION=""
case "$(basename "$0")" in
    rhino-7) NAME_VERSION=7 ;;
    rhino-8) NAME_VERSION=8 ;;
    rhino-9) NAME_VERSION=9 ;;
esac
SELF="$0" ORIG_ARGS=("$@")
STOP=0 FRESH=0
while [ $# -gt 0 ]; do
    case "$1" in
        --version) REQ_VERSION="${2:-}"; shift 2 ;;
        --version=*) REQ_VERSION="${1#--version=}"; shift ;;
        --fresh) FRESH=1; shift ;;
        --stop) STOP=1; shift ;;
        -h|--help)
            echo "Usage: rhino-linux [OPTIONS] [file.3dm ...]"
            echo ""
            echo "Options:"
            echo "  -h, --help       Show this help message"
            echo "  --version N      Open Rhino N (7, 8 or 9); default: the newest installed"
            echo "  --fresh          Restart wineserver before launch (fixes Cloud Zoo port 1717)"
            echo "  --stop           Stop Rhino: the version given, or every installed version"
            echo ""
            echo "Installed: $(rhino_installed_versions | sed 's/^/Rhino /' | paste -sd, - | sed 's/,/, /g')"
            echo ""
            echo "Environment:"
            echo "  RHINO_VERSION    Same as --version"
            echo "  RHINO_PREFIX     Use this Wine prefix instead"
            echo "  WINE             Path to Wine binary"
            exit 0
            ;;
        *) break ;;
    esac
done
# rhino-9 was the only command before 1.2, whatever the version installed: it
# opens the newest Rhino when Rhino 9 is not there.
if [ -z "$REQ_VERSION" ] && [ -n "$NAME_VERSION" ]; then
    if [ "$NAME_VERSION" != 9 ] || rhino_installed_versions | grep -x 9 >/dev/null; then
        REQ_VERSION="$NAME_VERSION"
    fi
fi
case "$REQ_VERSION" in ""|7|8|9) ;; *) echo "error: unknown Rhino version '$REQ_VERSION' (7, 8 or 9)" >&2; exit 1 ;; esac

# Prefix: an explicit one, the requested version's, else the newest installed.
if [ -n "$ENV_PREFIX" ]; then
    export WINEPREFIX="$ENV_PREFIX"
elif [ -n "$REQ_VERSION" ]; then
    export WINEPREFIX="$(rhino_prefix_for "$REQ_VERSION")"
else
    newest="$(rhino_newest_version)"
    if [ -n "$newest" ]; then
        export WINEPREFIX="$(rhino_prefix_for "$newest")"
    else
        export WINEPREFIX="$(rhino_legacy_prefix)"
    fi
fi

# Auto-detect Wine binary
WINE_BIN="${WINE:-$(rhino_config_get RHINO_WINE)}"
if [ -z "$WINE_BIN" ]; then
    if [ -n "${WINE_BUILD:-}" ] && [ -x "$WINE_BUILD/wine" ]; then
        WINE_BIN="$WINE_BUILD/wine"
    elif [ -x "${XDG_DATA_HOME:-$HOME/.local/share}/wine-rhino/bin/wine" ]; then
        WINE_BIN="${XDG_DATA_HOME:-$HOME/.local/share}/wine-rhino/bin/wine"
    elif [ -x "/opt/wine-rhino/bin/wine" ]; then
        WINE_BIN="/opt/wine-rhino/bin/wine"
    elif [ -x "$SCRIPT_DIR/../build-wine/wine" ]; then
        WINE_BIN="$SCRIPT_DIR/../build-wine/wine"
    elif [ -x "$SCRIPT_DIR/build-wine/wine" ]; then
        WINE_BIN="$SCRIPT_DIR/build-wine/wine"
    elif command -v wine >/dev/null 2>&1; then
        WINE_BIN="$(command -v wine)"
    else
        echo "error: No Wine binary found. Set WINE=/path/to/wine or run ./install.sh" >&2
        exit 1
    fi
fi

# Auto-detect wineserver binary
WINESERVER_BIN="${RHINO_WINESERVER:-$(rhino_config_get RHINO_WINESERVER)}"
if [ -z "$WINESERVER_BIN" ] || [ ! -x "$WINESERVER_BIN" ]; then
    if [ -x "$(dirname "$WINE_BIN")/wineserver" ]; then
        WINESERVER_BIN="$(dirname "$WINE_BIN")/wineserver"
    elif [ -x "$(dirname "$WINE_BIN")/server/wineserver" ]; then
        WINESERVER_BIN="$(dirname "$WINE_BIN")/server/wineserver"
    elif [ -x "$(dirname "$WINE_BIN")/../server/wineserver" ]; then
        WINESERVER_BIN="$(dirname "$WINE_BIN")/../server/wineserver"
    elif command -v wineserver >/dev/null 2>&1; then
        WINESERVER_BIN="$(command -v wineserver)"
    else
        WINESERVER_BIN="wineserver"
    fi
fi

# Every `flatpak run` is a sandbox with its own process ids, while all of them
# share the wineserver socket in /tmp. A wineserver can only manage processes
# with ids it knows, so Wine refuses processes of another instance; run in the
# instance that runs the prefix's wineserver instead, through its broker.
BROKER="$SCRIPT_DIR/rhino-broker.py"
use_broker() {
    [ -n "${FLATPAK_ID:-}" ] && [ -z "${RHINO_BROKER_CHILD:-}" ] && [ -f "$BROKER" ] &&
        command -v python3 >/dev/null 2>&1
}
# forward_to_broker PREFIX ARG...: run this launcher there; status 3: no broker
forward_to_broker() {
    local prefix="$1"; shift
    python3 "$BROKER" run "$prefix" -- "$SELF" "$@"
}
if [ "$STOP" -eq 0 ] && use_broker && [ -d "$WINEPREFIX" ]; then
    rc=0; forward_to_broker "$WINEPREFIX" "${ORIG_ARGS[@]}" || rc=$?
    [ "$rc" -eq 3 ] || exit "$rc"
fi

RHINO_NAME="$(find_rhino_dir "$WINEPREFIX" "${REQ_VERSION:-$RHINO_VERSIONS}" || echo "Rhino ${REQ_VERSION:-9}")"
RHINO_DIR="$WINEPREFIX/drive_c/Program Files/$RHINO_NAME/System"
RHINO_MAJOR="$(rhino_version_of_dir "$RHINO_NAME")"

# End every process in the prefix, which runs in this Flatpak instance (others
# are stopped through their broker): ask Wine to end its processes, then the
# wineserver.
stop_prefix() {
    local prefix="${1:-$WINEPREFIX}" socket
    socket="/tmp/.wine-$(id -u)/server-$(stat -c '%d-%i' "$prefix" 2>/dev/null | awk -F- '{printf "%x-%x", $1, $2}')/socket"
    if [ -x "$WINE_BIN" ] && [ -S "$socket" ]; then
        WINEPREFIX="$prefix" WINEDEBUG=-all "$WINE_BIN" wineboot -k >/dev/null 2>&1 || true
    fi
    local out
    out="$(WINEPREFIX="$prefix" "$WINESERVER_BIN" -k 2>&1)" || true
    if [[ "$out" == *"another PID namespace"* ]]; then
        # Started by a launcher without a broker, in another Flatpak instance:
        # its wineserver can't be reached from here, waiting for it would hang.
        echo "warning: Rhino runs in another instance that can't be stopped from here; close it from its window" >&2
        return 1
    fi
    WINEPREFIX="$prefix" "$WINESERVER_BIN" -w 2>/dev/null || true
}

if [ "$STOP" -eq 1 ]; then
    if [ ! -x "$WINESERVER_BIN" ] && ! command -v "$WINESERVER_BIN" >/dev/null 2>&1; then
        echo "error: wineserver binary not found: $WINESERVER_BIN" >&2
        exit 1
    fi
    if [ -n "$ENV_PREFIX" ] || [ -n "$REQ_VERSION" ]; then
        prefixes="$WINEPREFIX"
    else
        # "Rhino is stuck": every installed version, plus the legacy prefix.
        prefixes="$( { rhino_legacy_prefix; for v in $RHINO_VERSIONS; do rhino_prefix_for "$v"; done; } | sort -u)"
    fi
    while IFS= read -r prefix; do
        [ -d "$prefix/drive_c" ] || continue
        echo "Stopping Rhino Wine prefix ($prefix)..."
        if use_broker; then
            rc=0; RHINO_PREFIX="$prefix" forward_to_broker "$prefix" --stop >/dev/null || rc=$?
            [ "$rc" -eq 3 ] || continue
        fi
        stop_prefix "$prefix" || true
    done <<< "$prefixes"
    echo "Rhino Wine prefix stopped."
    exit 0
fi
if [ "$FRESH" -eq 1 ]; then
    echo "Restarting wineserver for clean http.sys state..."
    if [ -x "$WINESERVER_BIN" ] || command -v "$WINESERVER_BIN" >/dev/null 2>&1; then
        stop_prefix || true
    fi
    sleep 1
fi

if [ ! -x "$WINE_BIN" ] || [ ! -d "$RHINO_DIR" ]; then
    # The Flatpak's Rhino menu entry stays after Rhino is uninstalled: open the
    # setup app so the user can install it again instead of seeing nothing.
    if [ -n "${FLATPAK_ID:-}" ] && command -v rhino-on-linux >/dev/null 2>&1; then
        exec rhino-on-linux
    fi
    [ -x "$WINE_BIN" ] || echo "error: Wine not executable at $WINE_BIN" >&2
    [ -d "$RHINO_DIR" ] || echo "error: Rhino not found in $WINEPREFIX" >&2
    exit 1
fi

# Convert Linux paths or file:// URIs to Windows paths
args=()
for arg in "$@"; do
    if [[ "$arg" =~ ^file:// ]]; then
        arg="${arg#file://}"
    fi
    decoded_arg=$(printf '%b' "${arg//%/\\x}")
    if [ -e "$decoded_arg" ]; then
        abs_arg="$(readlink -f "$decoded_arg")"
        args+=("Z:${abs_arg//\//\\}")
    elif [[ "$arg" == ?:* || "$arg" == -* || "$arg" =~ ^/[a-zA-Z] ]]; then
        args+=("$arg")
    elif [[ "$arg" == /* ]]; then
        args+=("Z:${arg//\//\\}")
    else
        args+=("$arg")
    fi
done

# WebView2 mode: real Edge WebView2 enabled for panels and Cloud Zoo (Rhino 8 and 9)
ms="$WINEPREFIX/drive_c/Program Files (x86)/Microsoft"
if [ "$RHINO_MAJOR" = 7 ]; then
    :  # Rhino 7 has no embedded browser
elif [ "${RHINO_WEBVIEW2:-1}" = "1" ]; then
    [ -d "$ms/EdgeWebView.disabled" ] && mv "$ms/EdgeWebView.disabled" "$ms/EdgeWebView"
    [ -d "$ms/EdgeCore.disabled" ] && mv "$ms/EdgeCore.disabled" "$ms/EdgeCore"
    unset WEBVIEW2_BROWSER_EXECUTABLE_FOLDER
else
    wv2stub="$WINEPREFIX/drive_c/wv2stub"
    if [ ! -f "$wv2stub/msedgewebview2.exe" ]; then
        mkdir -p "$wv2stub"
        stub_src="$(find_asset "msedgewebview2-stub.exe")"
        if [ -n "$stub_src" ] && [ -f "$stub_src" ]; then
            cp "$stub_src" "$wv2stub/msedgewebview2.exe"
        fi
    fi
    export WEBVIEW2_BROWSER_EXECUTABLE_FOLDER="C:\\wv2stub"
    [ -d "$ms/EdgeWebView" ] && mv "$ms/EdgeWebView" "$ms/EdgeWebView.disabled"
    [ -d "$ms/EdgeCore" ] && mv "$ms/EdgeCore" "$ms/EdgeCore.disabled"
fi

export WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS="${WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS:---no-sandbox --disable-features=Translate,OptimizationHints,MediaRouter,DialMediaRouteProvider,CalculateNativeWinOcclusion,InterestFeedContentSuggestions,CertificateTransparencyComponentUpdater,AutofillServerCommunication,HeavyAdIntervention,RendererCodeIntegrity --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --disable-client-side-phishing-detection --disable-default-apps --disable-hang-monitor --disable-prompt-on-repost --disable-breakpad --disable-renderer-backgrounding --disable-background-timer-throttling --no-first-run --no-default-browser-check --no-pings --enable-gpu-rasterization --enable-zero-copy --disk-cache-size=33554432}"

# Suppress slow Wine console logging unless overridden by user
export WINEDEBUG="${WINEDEBUG:--all}"

# Multi-monitor & Fullscreen fix: Prevent mouse cursor confinement and sticky dragging
export WINE_DISABLE_CLIP_CURSOR=1

# NVIDIA anti-aliasing / smoothing optimizations
export __GL_ALLOW_FXAA_33=1

# NVIDIA shader disk cache optimizations
export __GL_SHADER_DISK_CACHE=1
export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1

# DXVK configuration resolution
dxvk_conf_path="$(find_asset "dxvk-rhino.conf")"
if [ -n "${RHINO_DXVK_CONF:-}" ] && [ -f "$RHINO_DXVK_CONF" ]; then
    export DXVK_CONFIG_FILE="$RHINO_DXVK_CONF"
elif [ -n "$dxvk_conf_path" ] && [ -f "$dxvk_conf_path" ]; then
    export DXVK_CONFIG_FILE="$dxvk_conf_path"
elif [ -f "$RHINO_DIR/dxvk.conf" ]; then
    export DXVK_CONFIG_FILE="$RHINO_DIR/dxvk.conf"
fi
export DXVK_STATE_CACHE=1
export DXVK_STATE_CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/dxvk"
mkdir -p "$DXVK_STATE_CACHE_PATH"

# Driver selection: Wine registry selects driver (HKCU\Software\Wine\Drivers\Graphics)
# Keep DISPLAY exported for X11/XWayland while preserving WAYLAND_DISPLAY for host processes (e.g. browser).
export DISPLAY="${DISPLAY:-:0}"
export RHINO_GRAPHICS_DRIVER="${RHINO_GRAPHICS_DRIVER:-x11}"

# ==============================================================================
# .NET 9 Runtime & RyuJIT Performance Tuning (Rhino Core, Grasshopper, Plugins)
# ==============================================================================
# 1. Garbage Collection tuning: Server GC for heavy meshing, or Workstation GC for responsive UI
export DOTNET_gcServer="${DOTNET_gcServer:-0}"

# 2. Dynamic Profile-Guided Optimization: RyuJIT devirtualization & AVX2 loop vectorization.
export DOTNET_TieredPGO=1
export DOTNET_TC_QuickJitForLoops=1
export DOTNET_ReadyToRun=1

# 3. Dynamic Heap Adaptation (DATAS) in .NET 9: balances heap size to active working set.
export DOTNET_GCDynamicAdaptationMode=1

# 4. Eliminate Wine W^X VirtualProtect overhead during JIT code page emission.
export DOTNET_EnableWriteXorExecute=0

# ==============================================================================
# OpenMP Thread Affinity & Scheduling (Multi-Threaded Solvers & Meshing Engines)
# ==============================================================================
# Pin worker threads across physical CPU cores to maximize L1/L2 cache locality
export OMP_PROC_BIND="${OMP_PROC_BIND:-spread}"
export OMP_PLACES="${OMP_PLACES:-cores}"

# Keep thread pools warm and prevent teardown churn between dynamic loop iterations
export OMP_DYNAMIC="${OMP_DYNAMIC:-false}"

# Worker thread wait policy: PASSIVE yields to kernel when idle (avoids 100% CPU spinning)
export OMP_WAIT_POLICY="${OMP_WAIT_POLICY:-PASSIVE}"

# ==============================================================================
# Linux Kernel In-Kernel Synchronization & Memory Allocator Tuning
# ==============================================================================
# Enable fast in-kernel NT synchronization if /dev/ntsync driver is active
if [ -e "/dev/ntsync" ]; then
    export WINENTSYNC="${WINENTSYNC:-1}"
fi

# Clear LD_PRELOAD to prevent host allocator collisions (e.g. jemalloc) from
# crashing external Linux processes spawned by Wine, such as the default web browser
# for Cloud Zoo authentication and licensing URLs.
unset LD_PRELOAD

# Linux Python settings reach Rhino's Windows Python through Wine and break it:
# the Flatpak runtime sets PYTHONUSERBASE=/var/data/python, which Python reads
# even in isolated mode (-I), and pip then fails with "path '/var/data/python'
# cannot be absolute", so the Script Editor cannot initialize Python 3.
unset PYTHONUSERBASE PYTHONPATH PYTHONHOME PYTHONSTARTUP


# DLL overrides:
# - vcomp140=builtin: Wine builtin vcomp with 64-bit dynamic loop patch bounds threads properly.
# - d3dcompiler_47=native,builtin: Required for complex HLSL shader compiling.
export WINEDLLOVERRIDES="vcomp140=builtin;d3dcompiler_47=native,builtin;${WINEDLLOVERRIDES:-}"

# Every version is "Rhino.exe"; its own window class (Wine patch 28) lets the
# taskbar show Rhino 7, 8 and 9 apart, each under its menu entry's icon.
if [ -n "$RHINO_MAJOR" ]; then
    export WINE_WM_CLASS="rhino$RHINO_MAJOR"
fi

# The graphics card Rhino draws with, chosen in the app or with RHINO_GPU=<part
# of its name>. With several cards DXVK can pick one that hangs Rhino at the
# start screen; it then only uses cards whose name contains this text.
RHINO_GPU="${RHINO_GPU-$(rhino_config_get RHINO_GPU)}"
if [ -n "$RHINO_GPU" ] && [ -z "${DXVK_FILTER_DEVICE_NAME:-}" ]; then
    export DXVK_FILTER_DEVICE_NAME="$RHINO_GPU"
fi

# OpenGL (the viewports of Rhino 7 and 8, and of Rhino 9 set to OpenGL): the
# native OpenGL driver, or with RHINO_GL=zink (chosen in the app) Mesa's Zink,
# which draws through the Vulkan driver. On NVIDIA cards both meet the same
# driver fault (Xid 109) now and then; NVIDIA's OpenGL recovers from it, Zink
# loses its device. Under Zink, Rhino 7's viewport can also show the frame
# before its last redraw.
find_zink() {
    local json dir
    for json in /usr/lib/x86_64-linux-gnu/GL/glvnd/egl_vendor.d/50_mesa.json \
                /usr/share/glvnd/egl_vendor.d/50_mesa.json /etc/glvnd/egl_vendor.d/50_mesa.json; do
        [ -f "$json" ] || continue
        for dir in /usr/lib/x86_64-linux-gnu/GL/default/lib/dri /usr/lib/x86_64-linux-gnu/dri \
                   /usr/lib64/dri /usr/lib/dri; do
            [ -e "$dir/zink_dri.so" ] && { echo "$json"; return 0; }
        done
    done
    return 1
}
RHINO_GL="${RHINO_GL-$(rhino_config_get RHINO_GL)}"
if [ "$RHINO_GL" = zink ] && [ -z "${__EGL_VENDOR_LIBRARY_FILENAMES:-}" ]; then
    if mesa_egl="$(find_zink)"; then
        export __EGL_VENDOR_LIBRARY_FILENAMES="$mesa_egl" __GLX_VENDOR_LIBRARY_NAME=mesa MESA_LOADER_DRIVER_OVERRIDE=zink
    else
        echo "rhino-linux: Zink (Mesa) is not installed; OpenGL uses the native driver" >&2
    fi
fi

# Rhino 7 runs on the .NET Framework 4.8 installed into its prefix (not Wine
# Mono) and draws its viewports with OpenGL 4.1.
if [ "$RHINO_MAJOR" = 7 ]; then
    export WINEDLLOVERRIDES="mscoree=native;$WINEDLLOVERRIDES"
    if [ "${RHINO_NO_VBLANK:-1}" = "1" ]; then
        export vblank_mode=0 __GL_SYNC_TO_VBLANK=0   # no swap stalls while drawing
    fi
    export __GL_YIELD="NOTHING" __GL_THREADED_OPTIMIZATIONS=1 mesa_glthread="${mesa_glthread:-true}"
    if [ -n "${RHINO_GL_OVERRIDE:-}" ]; then
        export MESA_GL_VERSION_OVERRIDE="$RHINO_GL_OVERRIDE" MESA_GLSL_VERSION_OVERRIDE="${RHINO_GLSL_OVERRIDE:-410}"
    fi
fi

# This instance runs the prefix's wineserver: take the broker, so that later
# launches run here. If another instance just took it, run there instead.
if use_broker; then
    rc=0; python3 "$BROKER" claim "$WINEPREFIX" || rc=$?
    if [ "$rc" -eq 4 ]; then
        rc=0; forward_to_broker "$WINEPREFIX" "${ORIG_ARGS[@]}" || rc=$?
        exit "$rc"
    fi
fi

# WebView2 (the Script Editor) on wined3d's Vulkan renderer, as deploy-rhino.sh
# sets up: its frames reach the screen evenly, while GL swaps stall now and then.
# Prefixes made before that get the setting once here.
if ! grep -qF 'msedgewebview2.exe\\Direct3D]' "$WINEPREFIX/user.reg" 2>/dev/null; then
    WINEDEBUG=-all "$WINE_BIN" reg add 'HKCU\Software\Wine\AppDefaults\msedgewebview2.exe\Direct3D' \
        /v renderer /d vulkan /f >/dev/null 2>&1 || true
fi

cd "$RHINO_DIR"
exec "$WINE_BIN" "C:\\Program Files\\$RHINO_NAME\\System\\Rhino.exe" "${args[@]}"
