[Desktop Entry]
Name=Rhinoceros
GenericName=3D CAD Modeler
Comment=Open the newest Rhino installed with Rhino on Linux; the menu lists each version
Exec=rhino-linux %F
Icon=io.github.jabern.RhinoOnLinux
Terminal=false
Type=Application
Categories=Graphics;3DGraphics;Engineering;
MimeType=application/x-3dm;
NoDisplay=true
StartupNotify=true
