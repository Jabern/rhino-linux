@@ -3166,11 +3166,58 @@ static inline int get_default_line_height( ME_TextEditor *editor )
 
     if (editor->pBuffer && editor->pBuffer->pDefaultStyle)
         height = editor->pBuffer->pDefaultStyle->tm.tmHeight;
+    /* The default style's metrics are only filled in once it has been
+     * selected into a DC, which may never happen if all text uses other
+     * styles.  Prefer the height of the first laid out row over a guess. */
+    if (height <= 0 && editor->pBuffer)
+    {
+        ME_Paragraph *para = editor_first_para( editor );
+        ME_Row *row = para ? para_first_row( para ) : NULL;
+        if (row) height = row->nHeight;
+    }
     if (height <= 0) height = 24;
 
     return height;
 }
 
+/* Distance for a single SB_LINEUP / SB_LINEDOWN step.  Native rich edit
+ * scrolls by whole rows, so use the row bordering the top of the view rather
+ * than the default font height.  Scrolling up moves the top of the view to
+ * the top of the row just above it; scrolling down moves it to the bottom of
+ * the row currently at the top.  Applications such as Rhino rely on this when
+ * they send SB_BOTTOM followed by SB_LINEUP to hide a trailing empty line. */
+static int get_line_scroll_height( ME_TextEditor *editor, BOOL up )
+{
+    ME_Paragraph *para = editor_first_para( editor );
+    ME_Row *row;
+    int pos = editor->vert_si.nPos;
+    int y = up ? pos - 1 : pos;
+
+    if (up && pos <= 0) return get_default_line_height( editor );
+
+    while (para && para_next( para ))
+    {
+        if (y < para->pt.y + para->nHeight) break;
+        para = para_next( para );
+    }
+
+    for (row = para ? para_first_row( para ) : NULL; row; row = row_next( row ))
+    {
+        int top = para->pt.y + row->pt.y;
+        int bottom = top + row->nHeight;
+
+        if (y < top) break;
+        if (y < bottom)
+        {
+            int amount = up ? pos - top : bottom - pos;
+            if (amount > 0) return amount;
+            break;
+        }
+    }
+
+    return get_default_line_height( editor );
+}
