diff --git a/dlls/user32/dialog.c b/dlls/user32/dialog.c
index b3bad848206..2f0003b5289 100644
--- a/dlls/user32/dialog.c
+++ b/dlls/user32/dialog.c
@@ -1968,3 +1968,64 @@ INT WINAPI DlgDirListComboBoxW( HWND hDlg, LPWSTR spec, INT idCBox,
 {
     return DIALOG_DlgDirListW( hDlg, spec, idCBox, idStatic, attrib, TRUE );
 }
+
+static const WCHAR dialog_dpi_behavior_propW[] = L"__wine_dialog_dpi_behavior";
+static const WCHAR dialog_control_dpi_behavior_propW[] = L"__wine_dialog_control_dpi_behavior";
+
+/**********************************************************************
+ *		SetDialogDpiChangeBehavior (USER32.@)
+ */
+BOOL WINAPI SetDialogDpiChangeBehavior( HWND hwnd, DIALOG_DPI_CHANGE_BEHAVIORS mask,
+                                        DIALOG_DPI_CHANGE_BEHAVIORS values )
+{
+    if (!IsWindow( hwnd ) || ((DWORD)values & ~(DWORD)mask))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    SetPropW( hwnd, dialog_dpi_behavior_propW, (HANDLE)(ULONG_PTR)((DWORD)values & (DWORD)mask) );
+    return TRUE;
+}
+
+/**********************************************************************
+ *		GetDialogDpiChangeBehavior (USER32.@)
+ */
+BOOL WINAPI GetDialogDpiChangeBehavior( HWND hwnd, DIALOG_DPI_CHANGE_BEHAVIORS *values )
+{
+    if (!values || !IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *values = (DIALOG_DPI_CHANGE_BEHAVIORS)(ULONG_PTR)GetPropW( hwnd, dialog_dpi_behavior_propW );
+    return TRUE;
+}
+
+/**********************************************************************
+ *		SetDialogControlDpiChangeBehavior (USER32.@)
+ */
+BOOL WINAPI SetDialogControlDpiChangeBehavior( HWND hwnd, DIALOG_CONTROL_DPI_CHANGE_BEHAVIORS mask,
+                                               DIALOG_CONTROL_DPI_CHANGE_BEHAVIORS values )
+{
+    if (!IsWindow( hwnd ) || ((DWORD)values & ~(DWORD)mask))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    SetPropW( hwnd, dialog_control_dpi_behavior_propW, (HANDLE)(ULONG_PTR)((DWORD)values & (DWORD)mask) );
+    return TRUE;
+}
+
+/**********************************************************************
+ *		GetDialogControlDpiChangeBehavior (USER32.@)
+ */
+BOOL WINAPI GetDialogControlDpiChangeBehavior( HWND hwnd, DIALOG_CONTROL_DPI_CHANGE_BEHAVIORS *values )
+{
+    if (!values || !IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *values = (DIALOG_CONTROL_DPI_CHANGE_BEHAVIORS)(ULONG_PTR)GetPropW( hwnd, dialog_control_dpi_behavior_propW );
+    return TRUE;
+}
