+/* The end of an environment string, reading four characters at a time:
+ * applications such as .NET query variables thousands of times, and each
+ * query walks the whole environment block. */
+static const WCHAR *env_string_end( const WCHAR *str )
+{
+    const ULONGLONG low = 0x0001000100010001ull, high = 0x8000800080008000ull;
+    ULONGLONG word;
+
+    if (!((ULONG_PTR)str & 1))
+    {
+        while ((ULONG_PTR)str & 7)
+        {
+            if (!*str) return str;
+            str++;
+        }
+        /* aligned reads never cross into the next page */
+        for (;;)
+        {
+            memcpy( &word, str, sizeof(word) );
+            if ((word - low) & ~word & high) break;
+            str += 4;
+        }
+    }
+    while (*str) str++;
+    return str;
+}
