+static HRESULT WINAPI ClientSite_QueryInterface(IOleClientSite *iface, REFIID riid, void **ppv)
+{
+    dialog_host_t *This = impl_from_IOleClientSite(iface);
+
+    if(IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IOleClientSite, riid))
+        *ppv = &This->IOleClientSite_iface;
+    else if(IsEqualGUID(&IID_IOleWindow, riid) || IsEqualGUID(&IID_IOleInPlaceSite, riid))
+        *ppv = &This->IOleInPlaceSite_iface;
+    else if(IsEqualGUID(&IID_IOleInPlaceUIWindow, riid) || IsEqualGUID(&IID_IOleInPlaceFrame, riid))
+        *ppv = &This->IOleInPlaceFrame_iface;
+    else if(IsEqualGUID(&IID_IDocHostUIHandler, riid))
+        *ppv = &This->IDocHostUIHandler_iface;
+    else {
+        TRACE("(%p)->(%s)\n", This, debugstr_mshtml_guid(riid));
+        *ppv = NULL;
+        return E_NOINTERFACE;
+    }
+
+    host_addref(This);
+    return S_OK;
+}
