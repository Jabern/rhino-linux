+/***********************************************************************
+ *          ShowHTMLDialogEx (MSHTML.@)
+ */
+HRESULT WINAPI ShowHTMLDialogEx(HWND hwndParent, IMoniker *pMk, DWORD dwDialogFlags,
+        VARIANT *pvarArgIn, WCHAR *pchOptions, VARIANT *pvArgOut)
+{
+    thread_data_t *thread_data;
+    dialog_options_t options;
+    struct html_dialog *dialog;
+    dialog_host_t *host;
+    HRESULT hres;
+
+    TRACE("(%p %p %lx %s %s %p)\n", hwndParent, pMk, dwDialogFlags, debugstr_variant(pvarArgIn),
+          debugstr_w(pchOptions), pvArgOut);
+
+    if(!pMk)
+        return E_INVALIDARG;
+    if(dwDialogFlags & ~(HTMLDLG_NOUI | HTMLDLG_MODAL | HTMLDLG_MODELESS | HTMLDLG_VERIFY | HTMLDLG_ALLOW_UNKNOWN_THREAD))
+        FIXME("unsupported flags %lx\n", dwDialogFlags);
+
+    if(pvArgOut)
+        V_VT(pvArgOut) = VT_EMPTY;
+
+    if(!register_dialog_class())
+        return E_FAIL;
+
+    parse_options(pchOptions, &options);
+
+    dialog = calloc(1, sizeof(*dialog));
+    host = calloc(1, sizeof(*host));
+    if(!dialog || !host) {
+        free(dialog);
+        free(host);
+        return E_OUTOFMEMORY;
+    }
+
+    dialog->ref = 1;
+    V_VT(&dialog->args) = VT_EMPTY;
+    V_VT(&dialog->ret) = VT_EMPTY;
+    if(pvarArgIn) {
+        hres = VariantCopyInd(&dialog->args, pvarArgIn);
+        if(FAILED(hres)) {
+            free(dialog);
+            free(host);
+            return hres;
+        }
+    }
+
+    host->IOleClientSite_iface.lpVtbl = &ClientSiteVtbl;
+    host->IOleInPlaceSite_iface.lpVtbl = &InPlaceSiteVtbl;
+    host->IOleInPlaceFrame_iface.lpVtbl = &InPlaceFrameVtbl;
+    host->IDocHostUIHandler_iface.lpVtbl = &DocHostUIHandlerVtbl;
+    host->IDispatch_iface.lpVtbl = &EventsVtbl;
+    host->ref = 1;
+    host->dialog = dialog;
+    host->modal = !(dwDialogFlags & HTMLDLG_MODELESS);
+    host->scroll = options.scroll;
+    host->owner = hwndParent ? GetAncestor(hwndParent, GA_ROOT) : NULL;
+
+    if(!create_dialog_window(host, &options)) {
+        ERR("Could not create dialog window\n");
+        host_release(host);
+        return E_FAIL;
+    }
+    dialog->hwnd = host->hwnd;
+
+    hres = create_browser(host);
+    if(SUCCEEDED(hres)) {
+        /* The document the WebBrowser creates next picks the dialog state up. */
+        thread_data = get_thread_data(TRUE);
+        if(thread_data) {
+            InterlockedIncrement(&dialog->ref);
+            thread_data->pending_dialog = dialog;
+        }
+
+        hres = navigate(host, pMk);
+
+        if(thread_data && thread_data->pending_dialog == dialog && FAILED(hres)) {
+            thread_data->pending_dialog = NULL;
+            html_dialog_release(dialog);
+        }
+    }
+
+    if(FAILED(hres)) {
+        ERR("Could not open the dialog: %08lx\n", hres);
+        DestroyWindow(host->hwnd);
+        host_release(host);
+        return hres;
+    }
+
+    if(!(dwDialogFlags & HTMLDLG_NOUI)) {
+        ShowWindow(host->hwnd, SW_SHOW);
+        SetForegroundWindow(host->hwnd);
+    }
+
+    if(!host->modal) {
+        host_release(host);
+        return S_OK;
+    }
+
+    if(host->owner)
+        EnableWindow(host->owner, FALSE);
+
+    run_modal_loop(host);
+
+    if(host->owner) {
+        EnableWindow(host->owner, TRUE);
+        SetActiveWindow(host->owner);
+    }
+
+    if(pvArgOut)
+        hres = VariantCopy(pvArgOut, &dialog->ret);
+
+    host_release(host);
+    return hres;
+}
