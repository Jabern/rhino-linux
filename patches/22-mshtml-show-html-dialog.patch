+} dialog_host_t;
+
+void html_dialog_release(struct html_dialog *dialog)
+{
+    if(InterlockedDecrement(&dialog->ref))
+        return;
+    VariantClear(&dialog->args);
+    VariantClear(&dialog->ret);
+    free(dialog);
+}
+
+static void host_addref(dialog_host_t *host)
+{
+    InterlockedIncrement(&host->ref);
+}
+
+static void host_release(dialog_host_t *host)
+{
+    if(InterlockedDecrement(&host->ref))
+        return;
+    if(host->dialog)
+        html_dialog_release(host->dialog);
+    free(host);
+}
