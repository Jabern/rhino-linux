+static void release_browser(dialog_host_t *host)
+{
+    thread_data_t *thread_data = get_thread_data(FALSE);
+
+    /* The document was never created: don't hand the state to an unrelated one later. */
+    if(thread_data && host->dialog && thread_data->pending_dialog == host->dialog) {
+        thread_data->pending_dialog = NULL;
+        html_dialog_release(host->dialog);
+    }
+
+    if(host->events_cp) {
+        IConnectionPoint_Unadvise(host->events_cp, host->events_cookie);
+        IConnectionPoint_Release(host->events_cp);
+        host->events_cp = NULL;
+    }
+    if(host->web_browser) {
+        IWebBrowser2_Release(host->web_browser);
+        host->web_browser = NULL;
+    }
+    if(host->ole_obj) {
+        IOleObject_Close(host->ole_obj, OLECLOSE_NOSAVE);
+        IOleObject_SetClientSite(host->ole_obj, NULL);
+        IOleObject_Release(host->ole_obj);
+        host->ole_obj = NULL;
+    }
+}
