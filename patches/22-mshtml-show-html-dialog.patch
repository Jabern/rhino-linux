+
+static HRESULT WINAPI Events_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *res, EXCEPINFO *ei, UINT *arg_err)
+{
+    dialog_host_t *This = impl_from_IDispatch(iface);
+
+    switch(id) {
+    case DISPID_TITLECHANGE:
+        if(params->cArgs == 1 && V_VT(params->rgvarg) == VT_BSTR && V_BSTR(params->rgvarg)
+           && *V_BSTR(params->rgvarg) && This->hwnd)
+            SetWindowTextW(This->hwnd, V_BSTR(params->rgvarg));
+        break;
+    case DISPID_WINDOWCLOSING:
+        /* window.close() from the page: close the dialog instead of the browser. */
+        if(params->cArgs == 2 && V_VT(params->rgvarg) == (VT_BYREF|VT_BOOL)) {
+            *V_BOOLREF(params->rgvarg) = VARIANT_TRUE;
+            if(This->hwnd)
+                PostMessageW(This->hwnd, WM_CLOSE, 0, 0);
+        }
+        break;
+    }
+    return S_OK;
+}
