+static BOOL translate_accelerator(dialog_host_t *host, MSG *msg)
+{
+    IOleInPlaceActiveObject *active;
+    HRESULT hres;
+
+    if(msg->message < WM_KEYFIRST || msg->message > WM_KEYLAST || !host->web_browser)
+        return FALSE;
+
+    hres = IWebBrowser2_QueryInterface(host->web_browser, &IID_IOleInPlaceActiveObject, (void**)&active);
+    if(FAILED(hres))
+        return FALSE;
+    hres = IOleInPlaceActiveObject_TranslateAccelerator(active, msg);
+    IOleInPlaceActiveObject_Release(active);
+    return hres == S_OK;
+}
+
+static LRESULT WINAPI dialog_wnd_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    dialog_host_t *host = (dialog_host_t*)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch(msg) {
+    case WM_NCCREATE:
+        host = ((CREATESTRUCTW*)lparam)->lpCreateParams;
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)host);
+        host->hwnd = hwnd;
+        host_addref(host);
+        break;
+    case WM_SIZE:
+        if(host && host->web_browser) {
+            RECT rect = {0, 0, LOWORD(lparam), HIWORD(lparam)};
+            IOleInPlaceSite_OnPosRectChange(&host->IOleInPlaceSite_iface, &rect);
+        }
+        return 0;
+    case WM_CLOSE:
+        /* Re-enable the owner first, so Windows activates it rather than another app. */
+        if(host && host->modal && host->owner)
+            EnableWindow(host->owner, TRUE);
+        DestroyWindow(hwnd);
+        return 0;
+    case WM_DESTROY:
+        if(host) {
+            host->closed = TRUE;
+            release_browser(host);
+        }
+        break;
+    case WM_NCDESTROY:
+        if(host) {
+            SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0);
+            host->hwnd = NULL;
+            if(host->dialog)
+                host->dialog->hwnd = NULL;
+            host_release(host);
+        }
+        break;
+    }
+
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+static BOOL register_dialog_class(void)
+{
+    static LONG registered;
+    WNDCLASSEXW wndclass = {sizeof(wndclass)};
+
+    if(registered)
+        return TRUE;
+
+    wndclass.lpfnWndProc = dialog_wnd_proc;
+    wndclass.hInstance = hInst;
+    wndclass.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wndclass.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1);
+    wndclass.lpszClassName = dialog_classW;
+    if(!RegisterClassExW(&wndclass) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS)
+        return FALSE;
+
+    InterlockedExchange(&registered, 1);
+    return TRUE;
+}
+
+typedef struct {
+    int width;
+    int height;
+    int left;
+    int top;
+    BOOL has_left;
+    BOOL has_top;
+    BOOL center;
+    BOOL resizable;
+    BOOL scroll;
+} dialog_options_t;
+
+/* Lengths are "300px", "20em", "10cm", or plain numbers (pixels). */
+static BOOL parse_length(const WCHAR *value, int *ret)
+{
+    WCHAR *end;
+    double val = wcstod(value, &end);
+
+    if(end == value)
+        return FALSE;
+    while(*end == ' ')
+        end++;
+
+    if(!wcsnicmp(end, L"em", 2))
+        val *= 16;
+    else if(!wcsnicmp(end, L"pt", 2))
+        val = val * 96 / 72;
+    else if(!wcsnicmp(end, L"cm", 2))
+        val = val * 96 / 2.54;
+    else if(!wcsnicmp(end, L"mm", 2))
+        val = val * 96 / 25.4;
+    else if(!wcsnicmp(end, L"in", 2))
+        val *= 96;
+
+    *ret = (int)(val + 0.5);
+    return TRUE;
+}
+
+static BOOL parse_bool(const WCHAR *value)
+{
+    return !wcsicmp(value, L"yes") || !wcsicmp(value, L"on") || !wcsicmp(value, L"true") || !wcscmp(value, L"1");
+}
+
+static void trim(WCHAR **start, WCHAR **end)
+{
+    while(*start < *end && (**start == ' ' || **start == '\t'))
+        (*start)++;
+    while(*end > *start && ((*end)[-1] == ' ' || (*end)[-1] == '\t'))
+        (*end)--;
+}
+
+/* Options look like "dialogWidth:300px; dialogHeight:200px; center:yes; resizable:no". */
+static void parse_options(const WCHAR *options, dialog_options_t *ret)
+{
+    WCHAR *buf, *ptr, *next, *name, *name_end, *value, *value_end;
+
+    ret->width = 600;
+    ret->height = 400;
+    ret->has_left = ret->has_top = FALSE;
+    ret->center = TRUE;
+    ret->resizable = FALSE;
+    ret->scroll = TRUE;
+
+    if(!options || !(buf = wcsdup(options)))
+        return;
+
+    for(ptr = buf; ptr && *ptr; ptr = next) {
+        next = wcspbrk(ptr, L";,");
+        if(next)
+            *next++ = 0;
+
+        name = ptr;
+        value = wcspbrk(ptr, L":=");
+        if(!value)
+            continue;
+        name_end = value++;
+        value_end = value + wcslen(value);
+        trim(&name, &name_end);
+        trim(&value, &value_end);
+        *name_end = 0;
+        *value_end = 0;
+
+        if(!wcsicmp(name, L"dialogWidth"))
+            parse_length(value, &ret->width);
+        else if(!wcsicmp(name, L"dialogHeight"))
+            parse_length(value, &ret->height);
+        else if(!wcsicmp(name, L"dialogLeft"))
+            ret->has_left = parse_length(value, &ret->left);
+        else if(!wcsicmp(name, L"dialogTop"))
+            ret->has_top = parse_length(value, &ret->top);
+        else if(!wcsicmp(name, L"center"))
+            ret->center = parse_bool(value);
+        else if(!wcsicmp(name, L"resizable"))
+            ret->resizable = parse_bool(value);
+        else if(!wcsicmp(name, L"scroll"))
+            ret->scroll = parse_bool(value);
+        else
+            TRACE("ignoring option %s=%s\n", debugstr_w(name), debugstr_w(value));
+    }
+
+    free(buf);
+}
+
+static HWND create_dialog_window(dialog_host_t *host, const dialog_options_t *options)
+{
+    DWORD style = WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN;
+    DWORD ex_style = WS_EX_DLGMODALFRAME | WS_EX_WINDOWEDGE;
+    RECT rect = {0, 0, options->width, options->height}, work;
+    HMONITOR monitor;
+    MONITORINFO mi = {sizeof(mi)};
+    int width, height, x, y;
+
+    if(options->resizable)
+        style |= WS_THICKFRAME | WS_MAXIMIZEBOX;
+
+    /* dialogWidth/dialogHeight give the size of the page area. */
+    AdjustWindowRectEx(&rect, style, FALSE, ex_style);
+    width = rect.right - rect.left;
+    height = rect.bottom - rect.top;
+
+    monitor = MonitorFromWindow(host->owner, MONITOR_DEFAULTTOPRIMARY);
+    GetMonitorInfoW(monitor, &mi);
+    work = mi.rcWork;
+
+    if(host->owner && !options->has_left && !options->has_top) {
+        RECT owner_rect;
+        GetWindowRect(host->owner, &owner_rect);
+        x = owner_rect.left + (owner_rect.right - owner_rect.left - width) / 2;
+        y = owner_rect.top + (owner_rect.bottom - owner_rect.top - height) / 2;
+    }else {
+        x = work.left + (work.right - work.left - width) / 2;
+        y = work.top + (work.bottom - work.top - height) / 2;
+    }
+    if(options->has_left)
+        x = options->left;
+    if(options->has_top)
+        y = options->top;
+
+    /* Keep the title bar on screen. */
+    if(x + width > work.right) x = work.right - width;
+    if(y + height > work.bottom) y = work.bottom - height;
+    if(x < work.left) x = work.left;
+    if(y < work.top) y = work.top;
+
+    return CreateWindowExW(ex_style, dialog_classW, L"", style, x, y, width, height,
+                           host->owner, NULL, hInst, host);
+}
+
+static HRESULT create_browser(dialog_host_t *host)
+{
+    IConnectionPointContainer *cp_container;
+    IOleInPlaceObject *inplace;
+    HRESULT hres;
+    RECT rect;
+
+    hres = CoCreateInstance(&CLSID_WebBrowser, NULL, CLSCTX_INPROC_SERVER, &IID_IOleObject, (void**)&host->ole_obj);
+    if(FAILED(hres)) {
+        ERR("Could not create WebBrowser: %08lx\n", hres);
+        return hres;
+    }
+
+    hres = IOleObject_SetClientSite(host->ole_obj, &host->IOleClientSite_iface);
+    if(FAILED(hres))
+        return hres;
+
+    GetClientRect(host->hwnd, &rect);
+    hres = IOleObject_DoVerb(host->ole_obj, OLEIVERB_INPLACEACTIVATE, NULL, &host->IOleClientSite_iface, -1,
+                             host->hwnd, &rect);
+    if(FAILED(hres))
+        return hres;
+
+    if(SUCCEEDED(IOleObject_QueryInterface(host->ole_obj, &IID_IOleInPlaceObject, (void**)&inplace))) {
+        IOleInPlaceObject_SetObjectRects(inplace, &rect, &rect);
+        IOleInPlaceObject_Release(inplace);
+    }
+
+    hres = IOleObject_QueryInterface(host->ole_obj, &IID_IWebBrowser2, (void**)&host->web_browser);
+    if(FAILED(hres))
+        return hres;
+
+    if(SUCCEEDED(IOleObject_QueryInterface(host->ole_obj, &IID_IConnectionPointContainer, (void**)&cp_container))) {
+        if(SUCCEEDED(IConnectionPointContainer_FindConnectionPoint(cp_container, &DIID_DWebBrowserEvents2,
+                                                                   &host->events_cp))) {
+            if(FAILED(IConnectionPoint_Advise(host->events_cp, (IUnknown*)&host->IDispatch_iface,
+                                              &host->events_cookie))) {
+                IConnectionPoint_Release(host->events_cp);
+                host->events_cp = NULL;
+            }
+        }
+        IConnectionPointContainer_Release(cp_container);
+    }
+
+    return S_OK;
+}
+
+static HRESULT navigate(dialog_host_t *host, IMoniker *mk)
+{
+    IBindCtx *bind_ctx;
+    WCHAR *url = NULL;
+    VARIANT empty, url_var;
+    HRESULT hres;
+
+    hres = CreateBindCtx(0, &bind_ctx);
+    if(FAILED(hres))
+        return hres;
+    hres = IMoniker_GetDisplayName(mk, bind_ctx, NULL, &url);
+    IBindCtx_Release(bind_ctx);
+    if(FAILED(hres))
+        return hres;
+
+    TRACE("url %s\n", debugstr_w(url));
+
+    V_VT(&empty) = VT_EMPTY;
+    V_VT(&url_var) = VT_BSTR;
+    V_BSTR(&url_var) = SysAllocString(url);
+    CoTaskMemFree(url);
+    if(!V_BSTR(&url_var))
+        return E_OUTOFMEMORY;
+
+    hres = IWebBrowser2_Navigate2(host->web_browser, &url_var, &empty, &empty, &empty, &empty);
+    SysFreeString(V_BSTR(&url_var));
+    return hres;
+}
+
+static void run_modal_loop(dialog_host_t *host)
+{
+    MSG msg;
+
+    while(!host->closed) {
+        BOOL ret = GetMessageW(&msg, NULL, 0, 0);
+        if(ret <= 0) {
+            /* Keep WM_QUIT for the application's own message loop. */
+            if(!ret)
+                PostQuitMessage(msg.wParam);
+            if(host->hwnd)
+                DestroyWindow(host->hwnd);
+            break;
+        }
+
+        if(host->hwnd && (msg.hwnd == host->hwnd || IsChild(host->hwnd, msg.hwnd))
+           && translate_accelerator(host, &msg))
+            continue;
+
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+}
