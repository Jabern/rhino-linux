diff --git a/dlls/opengl32/unix_wgl.c b/dlls/opengl32/unix_wgl.c
index 55321e1..914405e 100644
--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -1090,6 +1090,43 @@ void wrap_glGetFramebufferParameteriv( TEB *teb, GLenum target, GLenum pname, GL
     p_glGetFramebufferParameteriv( target, pname, params );
 }
 
+void wrap_glGetFramebufferAttachmentParameteriv( TEB *teb, GLenum target, GLenum attachment, GLenum pname, GLint *params,
+                                                 PFN_glGetFramebufferAttachmentParameteriv p_glGetFramebufferAttachmentParameteriv )
+{
+    struct opengl_drawable *draw, *read, *drawable;
+    struct opengl_context *ctx;
+    GLenum buffer = GL_NONE;
+    GLuint fbo;
+
+    if ((ctx = get_current_context( teb, &draw, &read, NULL )))
+    {
+        drawable = target == GL_READ_FRAMEBUFFER ? read : draw;
+        fbo = target == GL_READ_FRAMEBUFFER ? ctx->read_fbo : ctx->draw_fbo;
+
+        /* When the default framebuffer is a framebuffer object of win32u, its attachments are what
+         * the application draws to. The host surface it is presented to can have another format,
+         * with no alpha channel, samples or depth (see get_window_unused_drawable()): queries on
+         * the default framebuffer are answered from the framebuffer object's attachments. */
+        if (!fbo && drawable && drawable->draw_fbo && pname != GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME)
+        {
+            if (attachment == GL_DEPTH) buffer = GL_DEPTH_ATTACHMENT;
+            else if (attachment == GL_STENCIL) buffer = GL_STENCIL_ATTACHMENT;
+            else buffer = drawable_buffer_from_buffer( drawable, attachment );
+        }
+    }
+
+    if (buffer)
+    {
+        p_glGetFramebufferAttachmentParameteriv( target, buffer, pname, params );
+        if (pname == GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE && *params != GL_NONE) *params = GL_FRAMEBUFFER_DEFAULT;
+        return;
+    }
+
+    push_default_fbo( teb );
+    p_glGetFramebufferAttachmentParameteriv( target, attachment, pname, params );
+    pop_default_fbo( teb );
+}
+
 void wrap_glGetFramebufferParameterivEXT( TEB *teb, GLuint fbo, GLenum pname, GLint *params, PFN_glGetFramebufferParameterivEXT p_glGetFramebufferParameterivEXT )
 {
     struct opengl_drawable *draw, *read;
