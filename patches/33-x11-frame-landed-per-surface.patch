@@ -578,7 +586,11 @@ static void x11drv_client_surface_update( struct client_surface *client )
     HWND hwnd = client->hwnd;
 
     /* a surface kept for reuse loses its contents: wait for a new frame before showing it */
-    if (client->unused) surface->has_frame = FALSE;
