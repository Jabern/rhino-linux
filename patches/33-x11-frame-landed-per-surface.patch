+    if (!surface->has_frame && surface->damage &&
+        !(presenting_damage && damaged_drawable == surface->window &&
+          InterlockedCompareExchange( &surface->client.presented, 0, 0 )))
+        return;
     window = X11DRV_get_whole_window( toplevel );
