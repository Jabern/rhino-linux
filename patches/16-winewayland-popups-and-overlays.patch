+/**********************************************************************
+ *          update_client_overlaps
+ *
+ * Collects the rects of GDI sibling windows that are above the client
+ * surface in z-order and overlap it. These are re-composited above the
+ * client surface, which is placed below the toplevel GDI surface.
+ */
+static BOOL is_client_ancestor(struct wayland_client_surface *client, HWND hwnd)
+{
+    HWND ancestor = client->client.hwnd;
+
+    while ((ancestor = NtUserGetAncestor(ancestor, GA_PARENT)))
+    {
+        if (ancestor == hwnd) return TRUE;
+        if (ancestor == client->toplevel) break;
+    }
+    return FALSE;
+}
+
+static void collect_overlaps(struct wayland_client_surface *client, struct wayland_surface *surface,
+                             HWND parent, const RECT *visible, int depth, BOOL *done, BOOL above_only)
+{
+    HWND child;
+
+    if (depth > 16 || *done) return;
+
+    for (child = NtUserGetWindowRelative(parent, GW_CHILD); child && !*done; child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        struct wayland_win_data *child_data;
+        BOOL has_client_surface = FALSE;
+        RECT rect, intersection;
+
+        /* Children are iterated in z-order, topmost first. In overlay mode the
+         * client surface keeps its stock position, so only the windows above
+         * it need to be recomposited; stop when we reach it. */
+        if (above_only && child == client->client.hwnd)
+        {
+            *done = TRUE;
+            break;
+        }
+
+        if (!is_client_ancestor(client, child) && NtUserIsWindowVisible(child))
+        {
+            if ((child_data = wayland_win_data_get(child)))
+            {
+                has_client_surface = child_data->client_surface != NULL;
+                wayland_win_data_release(child_data);
+            }
+            if (!has_client_surface && NtUserGetWindowRect(child, &rect, 0))
+            {
+                OffsetRect(&rect, -visible->left, -visible->top);
+                rect = map_rect_to_surface(surface, rect);
+                if (client->nb_overlaps < ARRAY_SIZE(client->overlaps) &&
+                    intersect_rect(&intersection, &rect, &client->surface_rect))
+                {
+                    TRACE("overlay %p rect %s\n", child, wine_dbgstr_rect(&intersection));
+                    client->overlap_hwnds[client->nb_overlaps] = child;
+                    client->overlaps[client->nb_overlaps++] = intersection;
+                }
+            }
+        }
+
+        collect_overlaps(client, surface, child, visible, depth + 1, done, above_only);
+    }
+}
+
+static void update_client_overlaps(struct wayland_client_surface *client, struct wayland_surface *surface)
+{
+    struct wayland_win_data *data;
+    RECT visible = {0};
+    BOOL done = FALSE;
+    /* Collect all overlapping GDI windows, not just those above the client:
+     * applications (e.g. Rhino) can z-order the GL/D3D viewport window above
+     * the GDI siblings (viewport title bars) that must remain visible, so
+     * stopping at the client hwnd hides the titles again. */
+    BOOL above_only = FALSE;
+
+    client->nb_overlaps = 0;
+    if (!client->toplevel) return;
+    if (!(data = wayland_win_data_get(client->toplevel))) return;
+    visible = data->rects.visible;
+    wayland_win_data_release(data);
+
+    collect_overlaps(client, surface, client->toplevel, &visible, 0, &done, above_only);
+}
+
+void wayland_client_surface_update_overlaps(struct wayland_client_surface *client)
+{
+    struct wayland_win_data *data;
+    struct wayland_surface *surface;
+
+    if (!client->toplevel) return;
+    if (!(data = wayland_win_data_get(client->toplevel))) return;
+    if ((surface = data->wayland_surface)) update_client_overlaps(client, surface);
+    wayland_win_data_release(data);
+}
+
+static void destroy_overlays(struct wayland_client_surface *client)
+{
+    int i;
+
+    for (i = 0; i < client->nb_overlays; i++)
+    {
+        struct wayland_overlay *overlay = &client->overlays[i];
+        TRACE("hwnd %p rect %s\n", overlay->hwnd, wine_dbgstr_rect(&overlay->rect));
+        if (overlay->buffer) wayland_shm_buffer_unref(overlay->buffer);
+        if (overlay->wp_viewport) wp_viewport_destroy(overlay->wp_viewport);
+        if (overlay->wl_subsurface) wl_subsurface_destroy(overlay->wl_subsurface);
+        if (overlay->wl_surface) wl_surface_destroy(overlay->wl_surface);
+        memset(overlay, 0, sizeof(*overlay));
+    }
+    client->nb_overlays = 0;
+}
+
+static void create_overlay(struct wayland_client_surface *client, struct wayland_surface *surface,
+                           struct wayland_overlay *overlay, HWND hwnd, const RECT *rect)
+{
+    struct wl_region *empty_region;
+
+    memset(overlay, 0, sizeof(*overlay));
+    overlay->hwnd = hwnd;
+    overlay->rect = *rect;
+
+    if (!(overlay->wl_surface = wl_compositor_create_surface(process_wayland.wl_compositor))) return;
+    if (!(overlay->wl_subsurface = wl_subcompositor_get_subsurface(process_wayland.wl_subcompositor,
+                                                                   overlay->wl_surface, surface->wl_surface)))
+    {
+        wl_surface_destroy(overlay->wl_surface);
+        overlay->wl_surface = NULL;
+        return;
+    }
+
+    wl_subsurface_set_desync(overlay->wl_subsurface);
+    wl_subsurface_set_position(overlay->wl_subsurface, rect->left, rect->top);
+    wl_subsurface_place_above(overlay->wl_subsurface, client->wl_surface);
+
+    /* Let the parent handle all pointer events. */
+    empty_region = wl_compositor_create_region(process_wayland.wl_compositor);
+    if (empty_region)
+    {
+        wl_surface_set_input_region(overlay->wl_surface, empty_region);
+        wl_region_destroy(empty_region);
+    }
+
+    overlay->wp_viewport = wp_viewporter_get_viewport(process_wayland.wp_viewporter, overlay->wl_surface);
+    if (overlay->wp_viewport)
+        wp_viewport_set_destination(overlay->wp_viewport, rect->right - rect->left, rect->bottom - rect->top);
+
+    TRACE("hwnd %p rect %s client %p\n", hwnd, wine_dbgstr_rect(rect), client);
+}
+
+void wayland_client_surface_sync_overlays(struct wayland_client_surface *client, struct wayland_surface *surface)
+{
+    int i, j;
+    BOOL changed = FALSE;
+
+    client->overlays_dirty = FALSE;
+
+    if (!wayland_overlays || !client->toplevel || !client->wl_surface)
+    {
+        destroy_overlays(client);
+        return;
+    }
+
+    update_client_overlaps(client, surface);
+
+    /* Drop overlays that are no longer needed. */
+    for (i = 0; i < client->nb_overlays; i++)
+    {
+        struct wayland_overlay *overlay = &client->overlays[i];
+        BOOL found = FALSE;
+
+        for (j = 0; j < client->nb_overlaps; j++)
+        {
+            if (client->overlap_hwnds[j] == overlay->hwnd && EqualRect(&client->overlaps[j], &overlay->rect))
+            {
+                found = TRUE;
+                break;
+            }
+        }
+        if (found)
+        {
+            /* The client surface may have been re-stacked above us. */
+            wl_subsurface_set_position(overlay->wl_subsurface, overlay->rect.left, overlay->rect.top);
+            wl_subsurface_place_above(overlay->wl_subsurface, client->wl_surface);
+            continue;
+        }
+
+        if (overlay->buffer) wayland_shm_buffer_unref(overlay->buffer);
+        if (overlay->wp_viewport) wp_viewport_destroy(overlay->wp_viewport);
+        if (overlay->wl_subsurface) wl_subsurface_destroy(overlay->wl_subsurface);
+        if (overlay->wl_surface) wl_surface_destroy(overlay->wl_surface);
+        memmove(&client->overlays[i], &client->overlays[i + 1],
+                (client->nb_overlays - i - 1) * sizeof(*overlay));
+        client->nb_overlays--;
+        i--;
+        changed = TRUE;
+    }
+
+    /* Create overlays for new overlaps. */
+    for (j = 0; j < client->nb_overlaps && client->nb_overlays < ARRAY_SIZE(client->overlays); j++)
+    {
+        BOOL found = FALSE;
+
+        for (i = 0; i < client->nb_overlays; i++)
+        {
+            if (client->overlays[i].hwnd == client->overlap_hwnds[j] &&
+                EqualRect(&client->overlays[i].rect, &client->overlaps[j]))
+            {
+                found = TRUE;
+                break;
+            }
+        }
+        if (found) continue;
+
+        create_overlay(client, surface, &client->overlays[client->nb_overlays],
+                       client->overlap_hwnds[j], &client->overlaps[j]);
+        if (client->overlays[client->nb_overlays].wl_surface)
+        {
+            client->nb_overlays++;
+            changed = TRUE;
+        }
+    }
+
+    /* New overlays have no contents until the window surface is flushed.
+     * Do not call into win32u from here (synchronous NtUserRedrawWindow can
+     * deadlock the UI thread); rely on the next natural flush, which for
+     * Rhino also comes from the refresh watchdog. */
+    (void)changed;
+}
+
+void wayland_client_surface_update_overlay_buffers(struct wayland_client_surface *client,
+                                                   const RECT *surface_rect, const void *bits)
+{
+    static const int bpp = WINEWAYLAND_BYTES_PER_PIXEL;
+    int stride = (surface_rect->right - surface_rect->left) * bpp;
+    int i;
+
+    for (i = 0; i < client->nb_overlays; i++)
+    {
+        struct wayland_overlay *overlay = &client->overlays[i];
+        int w = overlay->rect.right - overlay->rect.left;
+        int h = overlay->rect.bottom - overlay->rect.top;
+        int y;
+
+        if (w <= 0 || h <= 0) continue;
+
+        if (!overlay->buffer || overlay->buffer->width != w || overlay->buffer->height != h)
+        {
+            if (overlay->buffer) wayland_shm_buffer_unref(overlay->buffer);
+            overlay->buffer = wayland_shm_buffer_create(w, h, WL_SHM_FORMAT_XRGB8888);
+            TRACE("hwnd %p rect %s buffer %p\n", overlay->hwnd, wine_dbgstr_rect(&overlay->rect), overlay->buffer);
+            if (!overlay->buffer) continue;
+        }
+
+        for (y = 0; y < h; y++)
+        {
+            int sy = overlay->rect.top + y;
+            char *dst = (char *)overlay->buffer->map_data + y * w * bpp;
+
+            if (sy < surface_rect->top || sy >= surface_rect->bottom)
+            {
+                memset(dst, 0, w * bpp);
+                continue;
+            }
+
+            {
+                int sx0 = max(overlay->rect.left, surface_rect->left);
+                int sx1 = min(overlay->rect.right, surface_rect->right);
+
+                if (sx0 > overlay->rect.left) memset(dst, 0, (sx0 - overlay->rect.left) * bpp);
+                if (sx0 < sx1)
+                    memcpy(dst + (sx0 - overlay->rect.left) * bpp,
+                           (const char *)bits + (sy - surface_rect->top) * stride + (sx0 - surface_rect->left) * bpp,
+                           (sx1 - sx0) * bpp);
+                if (sx1 < overlay->rect.right)
+                    memset(dst + (sx1 - overlay->rect.left) * bpp, 0, (overlay->rect.right - sx1) * bpp);
+            }
+        }
+
+        wl_surface_attach(overlay->wl_surface, overlay->buffer->wl_buffer, 0, 0);
+        wl_surface_damage_buffer(overlay->wl_surface, 0, 0, w, h);
+        wl_surface_commit(overlay->wl_surface);
+    }
+}
