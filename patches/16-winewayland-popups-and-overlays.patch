+/**********************************************************************
+ *          clear_buffer_region
+ *
+ * Clears (makes fully transparent) the pixels of the given region.
+ */
+static void clear_buffer_region(struct wayland_shm_buffer *buffer, HRGN region)
+{
+    static const int bpp = WINEWAYLAND_BYTES_PER_PIXEL;
+    RGNDATA *rgndata = get_region_data(region);
+    RECT *rgn_rect;
+    int stride = buffer->width * bpp;
+
+    if (!rgndata) return;
+
+    for (rgn_rect = (RECT *)rgndata->Buffer;
+         rgn_rect < (RECT *)rgndata->Buffer + rgndata->rdh.nCount; rgn_rect++)
+    {
+        RECT rc = *rgn_rect, clip = {0, 0, buffer->width, buffer->height};
+        int y;
+
+        if (!intersect_rect(&rc, &rc, &clip)) continue;
