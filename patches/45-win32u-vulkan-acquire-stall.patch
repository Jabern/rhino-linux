+/* An acquire asked to wait for ever can wait for ever: when the window system never gives
+ * an image back (seen with NVIDIA under Xwayland), DXVK's present thread blocked in it and
+ * Rhino froze with black windows. Wait in slices, and after ACQUIRE_STALL_NS without an
+ * image report the swapchain out of date, which applications handle by recreating it. */
+#define ACQUIRE_SLICE_NS 1000000000ull
+#define ACQUIRE_STALL_NS 10000000000ull
+
+/* info: vkAcquireNextImage2KHR's parameters, or NULL for vkAcquireNextImageKHR's */
+static VkResult acquire_with_stall_check( struct vulkan_device *device, VkAcquireNextImageInfoKHR *info,
+                                          VkSwapchainKHR swapchain, uint64_t timeout, VkSemaphore semaphore,
+                                          VkFence fence, uint32_t *image_index )
+{
+    uint64_t waited = 0, slice = timeout == UINT64_MAX ? ACQUIRE_SLICE_NS : timeout;
+    VkResult res;
+
+    for (;;)
+    {
+        if (info)
+        {
+            info->timeout = slice;
+            res = device->p_vkAcquireNextImage2KHR( device->host.device, info, image_index );
+            info->timeout = timeout;
+        }
+        else res = device->p_vkAcquireNextImageKHR( device->host.device, swapchain, slice, semaphore, fence, image_index );
+
+        if (res != VK_TIMEOUT || timeout != UINT64_MAX) return res;
+        if ((waited += slice) < ACQUIRE_STALL_NS) continue;
+        ERR( "no swapchain image after %llu s, reporting the swapchain out of date\n",
+             (unsigned long long)(waited / 1000000000) );
+        return VK_ERROR_OUT_OF_DATE_KHR;
+    }
+}
