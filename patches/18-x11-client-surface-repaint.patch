+/* Repaint asynchronously updated offscreen drawables without retaining a raw
+ * surface pointer across driver events. Destruction uses the same lock. */
+void present_client_surfaces( HWND hwnd )
+{
+    struct client_surface *surface;
+    HDC hdc = 0;
+
+    pthread_mutex_lock( &surfaces_lock );
+    LIST_FOR_EACH_ENTRY( surface, &client_surfaces, struct client_surface, entry )
+    {
+        if (surface->hwnd != hwnd || !surface->offscreen) continue;
+        client_surface_update_locked( surface );
+        if (!surface->offscreen) continue;
+        if (!hdc) hdc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_USESTYLE );
+        surface->funcs->present( surface, hdc );
+    }
+    if (hdc) NtUserReleaseDC( hwnd, hdc );
+    pthread_mutex_unlock( &surfaces_lock );
+}
