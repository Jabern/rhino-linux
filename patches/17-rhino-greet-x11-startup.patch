+static int is_window_owned_by( struct window *win, user_handle_t owner )
+{
+    unsigned int depth = 0;
+    while (win && win->owner && depth++ < 64)
+    {
+        if (win->owner == owner) return 1;
+        win = get_window( win->owner );
+    }
+    return 0;
+}
+
+static int restack_owned_windows( struct window *win )
+{
+    struct window *ptr, *next, *owner;
+    struct list *entry;
+    int changed = 0;
+
+    if (!win->parent) return 0;
+
+    /* 1. If win has an owner and win is below owner, move win above owner */
+    if (win->owner && (owner = get_window( win->owner )))
+    {
+        if (owner->parent == win->parent && owner->is_linked && win->is_linked)
+        {
+            int win_is_below = 0;
+            for (entry = owner->entry.next; entry != &win->parent->children; entry = entry->next)
+            {
+                if (entry == &win->entry)
+                {
+                    win_is_below = 1;
+                    break;
+                }
+            }
+            if (win_is_below)
+            {
+                list_remove( &win->entry );
+                list_add_before( &owner->entry, &win->entry );
+                if (owner->ex_style & WS_EX_TOPMOST) win->ex_style |= WS_EX_TOPMOST;
+                changed = 1;
+            }
+        }
+    }
+
+    /* 2. For any window owned by win that is below win, move it above win */
+    if (win->is_linked)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( ptr, next, &win->parent->children, struct window, entry )
+        {
+            if (ptr == win) continue;
+            if (is_window_owned_by( ptr, win->handle ))
+            {
+                int ptr_is_below = 0;
+                for (entry = win->entry.next; entry != &win->parent->children; entry = entry->next)
+                {
+                    if (entry == &ptr->entry)
+                    {
+                        ptr_is_below = 1;
+                        break;
+                    }
+                }
+                if (ptr_is_below)
+                {
+                    list_remove( &ptr->entry );
+                    list_add_before( &win->entry, &ptr->entry );
+                    if (win->ex_style & WS_EX_TOPMOST) ptr->ex_style |= WS_EX_TOPMOST;
+                    changed = 1;
+                }
+            }
+        }
+    }
+    return changed;
+}
