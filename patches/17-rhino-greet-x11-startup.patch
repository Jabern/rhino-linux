+static void raise_owned_windows( struct x11drv_win_data *data )
+{
+    HWND *list;
+    UINT i, count = 0;
+    Window win_stack[64];
+
+    if (!(list = build_hwnd_list())) return;
+
+    for (i = 0; list[i] != HWND_BOTTOM; i++)
+    {
+        HWND owner;
+        if (list[i] == data->hwnd) break;
+        owner = NtUserGetWindowRelative( list[i], GW_OWNER );
+        if (owner) owner = NtUserGetAncestor( owner, GA_ROOT );
+        if (owner == data->hwnd && NtUserIsWindowVisible( list[i] ))
+        {
+            Window win = X11DRV_get_whole_window( list[i] );
+            if (win && count < ARRAY_SIZE(win_stack))
+                win_stack[count++] = win;
+        }
+    }
+    free( list );
+
+    while (count > 0)
+    {
+        XRaiseWindow( data->display, win_stack[--count] );
+    }
+}
