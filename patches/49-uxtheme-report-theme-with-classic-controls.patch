 static ATOM atSubIdList;
 
 static BOOL bThemeActive = FALSE;
+/* Wine: tell applications the Aero theme is active while controls are drawn classic */
+static BOOL report_theme;
 static WCHAR szCurrentTheme[MAX_PATH];
 static WCHAR szCurrentColor[64];
 static WCHAR szCurrentSize[64];
@@ -130,6 +132,41 @@ static DWORD query_reg_path (HKEY hKey, LPCWSTR lpszValue,
   return dwRet;
 }
 
+/* HKCU\Software\Wine\AppDefaults\<app.exe>\Uxtheme or HKCU\Software\Wine\Uxtheme,
+ * "ReportTheme": with the theme off (classic controls drawn with the system colors), still
+ * report the Aero theme to applications that choose their own look from it. WPF picks its
+ * Aero2 styles from IsThemeActive and GetCurrentThemeName; with "classic" the styles some
+ * controls fall back to hardcode light colors that clash with dark system colors. */
+static BOOL get_report_value( const WCHAR *path, BOOL *ret )
+{
+    WCHAR value[8];
+    DWORD size = sizeof(value);
+    HKEY key;
+    LSTATUS status;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_QUERY_VALUE, &key )) return FALSE;
+    status = RegQueryValueExW( key, L"ReportTheme", NULL, NULL, (BYTE *)value, &size );
+    RegCloseKey( key );
+    if (status || !size) return FALSE;
+    *ret = value[0] == 'y' || value[0] == 'Y' || value[0] == '1';
+    return TRUE;
+}
+
+static BOOL get_report_theme(void)
+{
+    WCHAR module[MAX_PATH], path[MAX_PATH + 64], *name;
+    BOOL ret = FALSE;
+
+    if (GetModuleFileNameW( NULL, module, ARRAY_SIZE(module) ))
+    {
+        name = wcsrchr( module, '\\' );
+        swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\AppDefaults\\%s\\Uxtheme", name ? name + 1 : module );
+        if (get_report_value( path, &ret )) return ret;
+    }
+    get_report_value( L"Software\\Wine\\Uxtheme", &ret );
+    return ret;
+}
+
