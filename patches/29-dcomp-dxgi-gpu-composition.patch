+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_GetDesc1(IDXGISwapChain4 *iface, DXGI_SWAP_CHAIN_DESC1 *desc)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
