+HRESULT dxgi_composition_swapchain_create(IWineDXGIFactory *factory, IUnknown *device,
+        const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGISwapChain1 **swapchain)
+{
+    struct dxgi_composition_swapchain *object;
+    ID3D11Device *d3d11_device;
+    HRESULT hr;
+
+    if (desc->SwapEffect != DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL && desc->SwapEffect != DXGI_SWAP_EFFECT_FLIP_DISCARD)
+    {
+        WARN("Composition swap chains need a flip swap effect, got %#x.\n", desc->SwapEffect);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+    if (desc->Scaling != DXGI_SCALING_STRETCH || desc->SampleDesc.Count != 1 || !desc->Width || !desc->Height
+            || desc->BufferCount < 2 || desc->BufferCount > DXGI_MAX_SWAP_CHAIN_BUFFERS
+            || !is_composition_format(desc->Format) || desc->Stereo)
+    {
+        WARN("Invalid composition swap chain description.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    if (FAILED(IUnknown_QueryInterface(device, &IID_ID3D11Device, (void **)&d3d11_device)))
+    {
+        FIXME("Composition swap chains for device %p (not D3D11) are not implemented.\n", device);
+        return E_NOTIMPL;
+    }
+
+    if (!(object = calloc(1, sizeof(*object))))
+    {
+        ID3D11Device_Release(d3d11_device);
+        return E_OUTOFMEMORY;
+    }
+
+    object->IDXGISwapChain4_iface.lpVtbl = &composition_swapchain_vtbl;
+    object->IWineDXGICompositionSwapChain_iface.lpVtbl = &wine_composition_vtbl;
+    object->refcount = 1;
+    wined3d_private_store_init(&object->private_store);
+    object->factory = factory;
+    IWineDXGIFactory_AddRef(factory);
+    object->device = device;
+    IUnknown_AddRef(device);
+    object->d3d11_device = d3d11_device;
+    ID3D11Device_GetImmediateContext(d3d11_device, &object->context);
+    object->desc = *desc;
+    object->max_frame_latency = 3;
+    object->matrix._11 = object->matrix._22 = 1.0f;
+    object->color_space = DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709;
+    InitializeSRWLock(&object->listeners_lock);
+    if (desc->Flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT)
+        object->frame_latency_event = CreateEventW(NULL, FALSE, TRUE, NULL);
+
+    if (FAILED(hr = create_back_buffer(object)))
+    {
+        WARN("Failed to create the composition buffers, hr %#lx.\n", hr);
+        composition_swapchain_Release(&object->IDXGISwapChain4_iface);
+        return hr;
+    }
+
+    TRACE("Created composition swap chain %p, %ux%u %s.\n", object, desc->Width, desc->Height,
+            debug_dxgi_format(desc->Format));
+    *swapchain = (IDXGISwapChain1 *)&object->IDXGISwapChain4_iface;
+    return S_OK;
+}
