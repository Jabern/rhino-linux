+}
+
+static const struct IUnknownVtbl group_vtbl =
+{
+    group_QueryInterface,
+    group_AddRef,
+    group_Release,
+};
+
+static const struct object_class group_class = {&IID_IDCompositionTransform, DCOMP_TRANSFORM_GROUP, &group_vtbl};
+static const struct object_class group3d_class = {&IID_IDCompositionTransform3D, DCOMP_TRANSFORM_GROUP, &group_vtbl};
+
+static struct dcomp_object *unsafe_object_from(IUnknown *iface)
+{
+    unsigned int i;
+
+    if (!iface)
+        return NULL;
+    if (iface->lpVtbl == &group_vtbl)
+        return impl_from_iface(iface);
+    for (i = 0; i < ARRAY_SIZE(object_classes); ++i)
+    {
+        if ((const void *)iface->lpVtbl == object_classes[i].vtbl)
+            return impl_from_iface(iface);
+    }
+    return NULL;
+}
+
+static float value(const struct dcomp_object *object, unsigned int index)
+{
+    return dcomp_value_get(&object->values[index]);
+}
+
+static void rotation(struct dcomp_matrix *m, float degrees, float cx, float cy)
+{
+    float r = degrees * M_PI / 180.0f, c = cosf(r), s = sinf(r);
+
+    m->m11 = c;
+    m->m12 = s;
+    m->m21 = -s;
+    m->m22 = c;
+    m->dx = cx - cx * c + cy * s;
+    m->dy = cy - cx * s - cy * c;
+}
+
+static void object_get_matrix(const struct dcomp_object *object, struct dcomp_matrix *m)
+{
+    float sx, sy, cx, cy, tx, ty, ax, ay, az, len, r, c, s, t;
+    struct dcomp_matrix child;
+    struct dcomp_object *o;
+    UINT i;
+
+    dcomp_matrix_identity(m);
+    switch (object->class->kind)
+    {
+        case DCOMP_TRANSLATE:
+        case DCOMP_TRANSLATE3D:
+            m->dx = value(object, 0);
+            m->dy = value(object, 1);
+            break;
+
+        case DCOMP_SCALE:
+        case DCOMP_SCALE3D:
+            sx = value(object, 0);
+            sy = value(object, 1);
+            cx = value(object, object->class->kind == DCOMP_SCALE ? 2 : 3);
+            cy = value(object, object->class->kind == DCOMP_SCALE ? 3 : 4);
+            m->m11 = sx;
+            m->m22 = sy;
+            m->dx = cx - sx * cx;
+            m->dy = cy - sy * cy;
+            break;
+
+        case DCOMP_ROTATE:
+            rotation(m, value(object, 0), value(object, 1), value(object, 2));
+            break;
+
+        case DCOMP_ROTATE3D:
+            ax = value(object, 1);
+            ay = value(object, 2);
+            az = value(object, 3);
+            cx = value(object, 4);
+            cy = value(object, 5);
+            if (!(len = sqrtf(ax * ax + ay * ay + az * az)))
+                break;
+            ax /= len;
+            ay /= len;
+            az /= len;
+            /* The x/y part of the rotation around the axis; flat visuals have
+             * no depth, so a tilt only foreshortens. */
+            r = value(object, 0) * M_PI / 180.0f;
+            c = cosf(r);
+            s = sinf(r);
+            t = 1.0f - c;
+            m->m11 = t * ax * ax + c;
+            m->m12 = t * ax * ay + s * az;
+            m->m21 = t * ax * ay - s * az;
+            m->m22 = t * ay * ay + c;
+            m->dx = cx - cx * m->m11 - cy * m->m21;
+            m->dy = cy - cx * m->m12 - cy * m->m22;
+            break;
+
+        case DCOMP_SKEW:
+            tx = tanf(value(object, 0) * M_PI / 180.0f);
+            ty = tanf(value(object, 1) * M_PI / 180.0f);
+            cx = value(object, 2);
+            cy = value(object, 3);
+            m->m12 = ty;
+            m->m21 = tx;
+            m->dx = -cy * tx;
+            m->dy = -cx * ty;
+            break;
+
+        case DCOMP_MATRIX:
+            m->m11 = value(object, 0);
+            m->m12 = value(object, 1);
+            m->m21 = value(object, 2);
+            m->m22 = value(object, 3);
+            m->dx = value(object, 4);
+            m->dy = value(object, 5);
+            break;
+
+        case DCOMP_MATRIX3D:
+            m->m11 = value(object, 0);
+            m->m12 = value(object, 1);
+            m->m21 = value(object, 4);
+            m->m22 = value(object, 5);
+            m->dx = value(object, 12);
+            m->dy = value(object, 13);
+            break;
+
+        case DCOMP_TRANSFORM_GROUP:
+            for (i = 0; i < object->child_count; ++i)
+            {
+                if (!(o = unsafe_object_from(object->children[i])))
+                    continue;
+                object_get_matrix(o, &child);
+                dcomp_matrix_multiply(m, m, &child);
+            }
+            break;
+
+        default:
+            break;
+    }
+}
+
+HRESULT dcomp_transform_get_matrix(IUnknown *transform, struct dcomp_matrix *m)
+{
+    struct dcomp_object *object = unsafe_object_from(transform);
+
+    if (!object || object->class->kind > DCOMP_TRANSFORM_GROUP)
+    {
+        dcomp_matrix_identity(m);
+        return E_INVALIDARG;
+    }
+    object_get_matrix(object, m);
+    return S_OK;
+}
+
+HRESULT dcomp_clip_get_rect(IDCompositionClip *clip, D2D_RECT_F *rect)
+{
+    struct dcomp_object *object = unsafe_object_from((IUnknown *)clip);
+
+    if (!object || object->class->kind != DCOMP_RECT_CLIP)
+        return E_INVALIDARG;
+    /* Rounded corners are clipped as square ones. */
+    rect->left = value(object, 0);
+    rect->top = value(object, 1);
+    rect->right = value(object, 2);
+    rect->bottom = value(object, 3);
+    return S_OK;
+}
+
+BOOL dcomp_effect_get_opacity(IDCompositionEffect *effect, float *opacity, struct dcomp_matrix *transform,
+        BOOL *has_transform)
+{
+    struct dcomp_object *object = unsafe_object_from((IUnknown *)effect);
+    struct dcomp_object *t;
+
+    *has_transform = FALSE;
+    if (!object)
+        return FALSE;
+    if (object->class->kind != DCOMP_EFFECT_GROUP)
+    {
+        FIXME_(dcomp)("Effect %s is not drawn.\n", debugstr_guid(object->class->iid));
+        return FALSE;
+    }
+    *opacity = value(object, 0);
+    if ((t = unsafe_object_from(object->transform)))
+    {
+        object_get_matrix(t, transform);
+        *has_transform = TRUE;
+    }
+    return TRUE;
+}
+
+static HRESULT object_create(struct dcomp_device *device, const struct object_class *class, void **out)
+{
+    struct dcomp_object *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IUnknown_iface.lpVtbl = class->vtbl;
+    object->refcount = 1;
+    object->device = device;
+    dcomp_device_add_ref(device);
+    object->class = class;
+
+    /* Defaults that are not zero. */
+    switch (class->kind)
+    {
+        case DCOMP_SCALE:
+        case DCOMP_SCALE3D:
+            dcomp_value_set(&object->values[0], 1.0f);
+            dcomp_value_set(&object->values[1], 1.0f);
+            if (class->kind == DCOMP_SCALE3D)
+                dcomp_value_set(&object->values[2], 1.0f);
+            break;
+        case DCOMP_ROTATE3D:
+            dcomp_value_set(&object->values[3], 1.0f);
+            break;
+        case DCOMP_MATRIX:
+            dcomp_value_set(&object->values[0], 1.0f);
+            dcomp_value_set(&object->values[3], 1.0f);
+            break;
+        case DCOMP_MATRIX3D:
+            dcomp_value_set(&object->values[0], 1.0f);
+            dcomp_value_set(&object->values[5], 1.0f);
+            dcomp_value_set(&object->values[10], 1.0f);
+            dcomp_value_set(&object->values[15], 1.0f);
+            break;
+        case DCOMP_RECT_CLIP:
+            /* An edge that is never set does not clip. */
+            dcomp_value_set(&object->values[0], -FLT_MAX);
+            dcomp_value_set(&object->values[1], -FLT_MAX);
+            dcomp_value_set(&object->values[2], FLT_MAX);
+            dcomp_value_set(&object->values[3], FLT_MAX);
+            break;
+        case DCOMP_EFFECT_GROUP:
+            dcomp_value_set(&object->values[0], 1.0f);
+            break;
+        default:
+            break;
+    }
+
+    *out = &object->IUnknown_iface;
+    return S_OK;
+}
+
+static const struct object_class *find_class(REFIID iid)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(object_classes); ++i)
+    {
+        if (IsEqualGUID(object_classes[i].iid, iid))
+            return &object_classes[i];
+    }
+    return NULL;
+}
+
+HRESULT dcomp_transform_create(struct dcomp_device *device, REFIID iid, void **transform)
+{
+    const struct object_class *class = find_class(iid);
+
+    if (!class)
+        return E_NOINTERFACE;
+    return object_create(device, class, transform);
+}
+
+HRESULT dcomp_rectangle_clip_create(struct dcomp_device *device, IDCompositionRectangleClip **clip)
+{
+    return object_create(device, find_class(&IID_IDCompositionRectangleClip), (void **)clip);
+}
+
+HRESULT dcomp_effect_group_create(struct dcomp_device *device, IDCompositionEffectGroup **group)
+{
+    return object_create(device, find_class(&IID_IDCompositionEffectGroup), (void **)group);
+}
+
+HRESULT dcomp_filter_effect_create(struct dcomp_device *device, REFIID iid, void **effect)
+{
+    const struct object_class *class = find_class(iid);
+
+    if (!class || class->kind != DCOMP_FILTER_EFFECT)
+        return E_NOINTERFACE;
+    return object_create(device, class, effect);
+}
+
+HRESULT dcomp_transform_group_create(struct dcomp_device *device, IUnknown **transforms, UINT count,
+        BOOL is_3d, void **out)
+{
+    struct dcomp_object *group, *child;
+    HRESULT hr;
+    UINT i;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (!(child = unsafe_object_from(transforms[i])) || child->class->kind > DCOMP_TRANSFORM_GROUP
+                || (!is_3d && child->is_3d))
+            return E_INVALIDARG;
+    }
+
+    if (FAILED(hr = object_create(device, is_3d ? &group3d_class : &group_class, out)))
+        return hr;
+    group = impl_from_iface(*out);
+    group->is_3d = is_3d;
+    if (count && !(group->children = calloc(count, sizeof(*group->children))))
+    {
+        object_release(group);
+        *out = NULL;
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        group->children[i] = transforms[i];
+        IUnknown_AddRef(transforms[i]);
+    }
+    group->child_count = count;
+    return S_OK;
+}
