+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "dcomp_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+static const struct IDCompositionVisual3Vtbl visual_vtbl;
+
+static inline struct dcomp_visual *impl_from_IDCompositionVisual3(IDCompositionVisual3 *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_visual, IDCompositionVisual3_iface);
+}
+
+struct dcomp_visual *unsafe_impl_from_IDCompositionVisual(IDCompositionVisual *iface)
+{
+    if (!iface)
+        return NULL;
+    if (iface->lpVtbl != (const IDCompositionVisualVtbl *)&visual_vtbl)
+        return NULL;
+    return impl_from_IDCompositionVisual3((IDCompositionVisual3 *)iface);
+}
+
+static void release_state(struct dcomp_visual_state *state)
+{
+    SIZE_T i;
+
+    if (state->content)
+        IUnknown_Release(state->content);
+    for (i = 0; i < state->child_count; ++i)
+        IDCompositionVisual3_Release(&state->children[i]->IDCompositionVisual3_iface);
+    free(state->children);
+    state->content = NULL;
+    state->children = NULL;
+    state->child_count = 0;
+}
+
+static enum dcomp_content_type get_content_type(IUnknown *content)
+{
+    IWineDXGICompositionSwapChain *swapchain;
+
+    if (!content)
+        return DCOMP_CONTENT_NONE;
+    if (unsafe_impl_from_IDCompositionSurface(content))
+        return DCOMP_CONTENT_SURFACE;
+    if (SUCCEEDED(IUnknown_QueryInterface(content, &IID_IWineDXGICompositionSwapChain, (void **)&swapchain)))
+    {
+        IWineDXGICompositionSwapChain_Release(swapchain);
+        return DCOMP_CONTENT_SWAPCHAIN;
+    }
+    FIXME("Unsupported content %p.\n", content);
+    return DCOMP_CONTENT_NONE;
+}
+
+/* Freeze the pending state into the committed one. Called with the device lock. */
+void dcomp_visual_commit(struct dcomp_visual *visual)
+{
+    struct dcomp_visual_state *state = &visual->committed;
+    struct dcomp_matrix local, offset, effect_transform;
+    BOOL has_effect_transform = FALSE;
+    float effect_opacity = 1.0f;
+    SIZE_T i;
+
+    release_state(state);
+
+    /* The visual's own transform, then its offset into the parent. */
+    dcomp_matrix_identity(&local);
+    if (visual->transform_object)
+        dcomp_transform_get_matrix(visual->transform_object, &local);
+    else if (visual->has_matrix)
+        local = visual->matrix;
+    if (visual->effect && dcomp_effect_get_opacity(visual->effect, &effect_opacity, &effect_transform,
+            &has_effect_transform) && has_effect_transform)
+    {
+        struct dcomp_matrix m = local;
+        dcomp_matrix_multiply(&local, &m, &effect_transform);
+    }
+    dcomp_matrix_identity(&offset);
+    offset.dx = dcomp_value_get(&visual->offset_x);
+    offset.dy = dcomp_value_get(&visual->offset_y);
+    dcomp_matrix_multiply(&state->transform, &local, &offset);
+
+    state->has_clip = FALSE;
+    if (visual->clip_object)
+        state->has_clip = SUCCEEDED(dcomp_clip_get_rect(visual->clip_object, &state->clip));
+    else if (visual->has_clip_rect)
+    {
+        state->clip = visual->clip_rect;
+        state->has_clip = TRUE;
+    }
+
+    state->opacity = max(0.0f, min(1.0f, dcomp_value_get(&visual->opacity) * effect_opacity));
+    state->visible = visual->visible;
+    state->interpolation = visual->interpolation;
+
+    if ((state->content = visual->content))
+        IUnknown_AddRef(state->content);
+    state->content_type = get_content_type(state->content);
+
+    if (visual->child_count && (state->children = malloc(visual->child_count * sizeof(*state->children))))
+    {
+        for (i = 0; i < visual->child_count; ++i)
+        {
+            state->children[i] = visual->children[i];
+            IDCompositionVisual3_AddRef(&state->children[i]->IDCompositionVisual3_iface);
+        }
+        state->child_count = visual->child_count;
+    }
+}
