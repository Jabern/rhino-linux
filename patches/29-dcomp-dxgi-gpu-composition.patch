-static void dcomp_visual_set_target_hwnd(struct dcomp_visual *visual, HWND target_hwnd)
-{
-    struct dcomp_visual *child;
-    visual->target_hwnd = target_hwnd;
-    if (visual->content)
-        dcomp_visual_try_reparent(visual);
-    for (child = visual->children; child; child = child->next_sibling)
-        dcomp_visual_set_target_hwnd(child, target_hwnd);
-}
