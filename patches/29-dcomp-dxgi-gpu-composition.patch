+HRESULT dcomp_visual_create(struct dcomp_device *device, IDCompositionVisual3 **out)
+{
+    struct dcomp_visual *visual;
+
+    if (!(visual = calloc(1, sizeof(*visual))))
+        return E_OUTOFMEMORY;
+
+    visual->IDCompositionVisual3_iface.lpVtbl = &visual_vtbl;
+    visual->refcount = 1;
+    visual->device = device;
+    dcomp_device_add_ref(device);
+    dcomp_value_set(&visual->opacity, 1.0f);
+    visual->visible = TRUE;
+    visual->interpolation = DCOMPOSITION_BITMAP_INTERPOLATION_MODE_INHERIT;
+    dcomp_matrix_identity(&visual->matrix);
+    dcomp_matrix_identity(&visual->committed.transform);
+    visual->committed.opacity = 1.0f;
+    visual->committed.visible = TRUE;
+    visual->committed.interpolation = DCOMPOSITION_BITMAP_INTERPOLATION_MODE_INHERIT;
+
+    dcomp_device_lock(device);
+    list_add_tail(&device->visuals, &visual->entry);
+    dcomp_device_unlock(device);
+
+    TRACE("Created visual %p.\n", visual);
+    *out = &visual->IDCompositionVisual3_iface;
+    return S_OK;
+}
