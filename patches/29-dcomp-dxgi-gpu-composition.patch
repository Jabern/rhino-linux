+#include "wine/list.h"
+#include "wine/debug.h"
+
+/* How DirectComposition works here
+ *
+ * Every object belongs to a device, and the device lock guards them all.
+ * Setters change an object's pending state. Commit freezes the pending state
+ * of every visual into its committed state, resolving transform, clip and
+ * effect objects into plain values, so later changes stay invisible until the
+ * next Commit, as on Windows.
+ *
+ * The compositor draws the committed tree of each target into a swap chain
+ * for the target's window, on the GPU, with the device's D3D11 device. It
+ * runs after a Commit and after a composition swap chain shown in a tree
+ * presents a frame. */
+
+struct dcomp_device;
+struct dcomp_visual;
+
+/* 2D affine matrix, row vector convention: [x y 1] * M. */
+struct dcomp_matrix
+{
+    float m11, m12, m21, m22, dx, dy;
+};
+
+void dcomp_matrix_identity(struct dcomp_matrix *m);
+void dcomp_matrix_multiply(struct dcomp_matrix *out, const struct dcomp_matrix *a, const struct dcomp_matrix *b);
+void dcomp_matrix_transform_point(const struct dcomp_matrix *m, float x, float y, float *out_x, float *out_y);
+
+/* An animatable float: a constant, or the value of an animation. */
+struct dcomp_value
+{
+    float value;
+    IDCompositionAnimation *animation;
+};
+
+void dcomp_value_set(struct dcomp_value *v, float value);
+HRESULT dcomp_value_set_animation(struct dcomp_value *v, IDCompositionAnimation *animation);
+float dcomp_value_get(const struct dcomp_value *v);
+void dcomp_value_cleanup(struct dcomp_value *v);
+
+/* Objects other code needs to look into. */
+HRESULT dcomp_transform_get_matrix(IUnknown *transform, struct dcomp_matrix *matrix);
+HRESULT dcomp_clip_get_rect(IDCompositionClip *clip, D2D_RECT_F *rect);
+BOOL dcomp_effect_get_opacity(IDCompositionEffect *effect, float *opacity, struct dcomp_matrix *transform,
+        BOOL *has_transform);
+HRESULT dcomp_animation_create(IDCompositionAnimation **animation);
+HRESULT dcomp_rectangle_clip_create(struct dcomp_device *device, IDCompositionRectangleClip **clip);
+HRESULT dcomp_effect_group_create(struct dcomp_device *device, IDCompositionEffectGroup **group);
+HRESULT dcomp_transform_create(struct dcomp_device *device, REFIID iid, void **transform);
+HRESULT dcomp_transform_group_create(struct dcomp_device *device, IUnknown **transforms, UINT count,
+        BOOL is_3d, void **group);
+HRESULT dcomp_filter_effect_create(struct dcomp_device *device, REFIID iid, void **effect);
+
+/* Surfaces */
+
+struct dcomp_surface
+{
+    IDCompositionVirtualSurface IDCompositionVirtualSurface_iface;
+    LONG refcount;
+    struct dcomp_device *device;
+    BOOL is_virtual;
+
+    UINT width, height;
+    DXGI_FORMAT format;
+    DXGI_ALPHA_MODE alpha_mode;
+    ID3D11Texture2D *texture;
+    ID3D11ShaderResourceView *view;
+    BOOL drawing;
+    BOOL has_content;
+};
+
+struct dcomp_surface *unsafe_impl_from_IDCompositionSurface(IUnknown *iface);
+HRESULT dcomp_surface_create(struct dcomp_device *device, ID3D11Device *d3d11_device, UINT width, UINT height,
+        DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, BOOL is_virtual, IDCompositionVirtualSurface **surface);
+HRESULT dcomp_surface_factory_create(struct dcomp_device *device, IUnknown *rendering_device,
+        IDCompositionSurfaceFactory **factory);
+
+/* Visuals */
+
+enum dcomp_content_type
+{
+    DCOMP_CONTENT_NONE,
+    DCOMP_CONTENT_SURFACE,
+    DCOMP_CONTENT_SWAPCHAIN,
+};
+
+/* What a visual shows and how, as of the last Commit. */
+struct dcomp_visual_state
+{
+    struct dcomp_matrix transform;      /* local transform followed by the offset */
+    BOOL has_clip;
+    D2D_RECT_F clip;                    /* in the visual's own space */
+    float opacity;
+    BOOL visible;
+    enum DCOMPOSITION_BITMAP_INTERPOLATION_MODE interpolation;
+    enum dcomp_content_type content_type;
+    IUnknown *content;                  /* reference held */
+    struct dcomp_visual **children;     /* bottom to top, references held */
+    SIZE_T child_count;
+};
+
+struct dcomp_visual
+{
+    IDCompositionVisual3 IDCompositionVisual3_iface;
+    LONG refcount;
+    struct dcomp_device *device;
+    struct list entry;                  /* in device->visuals */
+
+    /* pending state, changed by the setters */
+    struct dcomp_value offset_x, offset_y;
+    BOOL has_matrix;
+    struct dcomp_matrix matrix;
+    IUnknown *transform_object;
+    IDCompositionEffect *effect;
+    enum DCOMPOSITION_BITMAP_INTERPOLATION_MODE interpolation;
+    BOOL has_clip_rect;
+    D2D_RECT_F clip_rect;
+    IDCompositionClip *clip_object;
+    IUnknown *content;
+    struct dcomp_value opacity;
+    BOOL visible;
+    struct dcomp_visual **children;     /* bottom to top, references held */
+    SIZE_T child_count, children_size;
+    struct dcomp_visual *parent;
+
+    struct dcomp_visual_state committed;
+};
+
+struct dcomp_visual *unsafe_impl_from_IDCompositionVisual(IDCompositionVisual *iface);
+HRESULT dcomp_visual_create(struct dcomp_device *device, IDCompositionVisual3 **visual);
+void dcomp_visual_commit(struct dcomp_visual *visual);
+
+/* Targets */
+
+struct dcomp_target
+{
+    IDCompositionTarget IDCompositionTarget_iface;
+    LONG refcount;
+    struct dcomp_device *device;
+    struct list entry;                  /* in device->targets */
+    HWND hwnd;
+    BOOL topmost;
+    struct dcomp_visual *root, *committed_root;
+
+    /* compositor state */
+    IDXGISwapChain1 *swapchain;
+    ID3D11RenderTargetView *rtv;
+    UINT width, height;
+    BOOL needs_compose;
+};
+
+HRESULT dcomp_target_create(struct dcomp_device *device, HWND hwnd, BOOL topmost, IDCompositionTarget **target);
+
+/* Device */
+
+struct dcomp_compositor;
+
+struct dcomp_device
+{
+    IDCompositionDevice IDCompositionDevice_iface;
+    IDCompositionDesktopDevice IDCompositionDesktopDevice_iface;
+    IDCompositionDevice3 IDCompositionDevice3_iface;
+    LONG refcount;
+    CRITICAL_SECTION cs;
+
+    ID3D11Device *d3d11_device;
+    ID3D11DeviceContext1 *context;
+    struct dcomp_compositor *compositor;
+
+    struct list targets;
+    struct list visuals;
+    /* composition swap chains we listen to */
+    IWineDXGICompositionSwapChain **swapchains;
+    SIZE_T swapchain_count, swapchains_size;
+};
+
+void dcomp_device_lock(struct dcomp_device *device);
+void dcomp_device_unlock(struct dcomp_device *device);
+ULONG dcomp_device_add_ref(struct dcomp_device *device);
+ULONG dcomp_device_release(struct dcomp_device *device);
+HRESULT dcomp_device_create(IUnknown *rendering_device, REFIID iid, void **out);
+void dcomp_device_watch_swapchain(struct dcomp_device *device, IUnknown *content);
+
+/* Compositor */
+
+HRESULT dcomp_compositor_create(ID3D11Device *d3d11_device, struct dcomp_compositor **compositor);
+void dcomp_compositor_destroy(struct dcomp_compositor *compositor);
+void dcomp_compositor_compose(struct dcomp_device *device, struct dcomp_target *target);
+void dcomp_compositor_release_target(struct dcomp_target *target);
+
+/* Helpers */
+
+static inline BOOL dcomp_array_reserve(void **elements, SIZE_T *capacity, SIZE_T count, SIZE_T size)
+{
+    SIZE_T new_capacity;
+    void *new_elements;
+
+    if (count <= *capacity)
+        return TRUE;
+    new_capacity = max(*capacity * 2, max(count, 4));
+    if (!(new_elements = realloc(*elements, new_capacity * size)))
+        return FALSE;
+    *elements = new_elements;
+    *capacity = new_capacity;
+    return TRUE;
+}
+
+#endif /* __WINE_DCOMP_PRIVATE_H */
