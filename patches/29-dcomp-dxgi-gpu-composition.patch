+static HRESULT STDMETHODCALLTYPE target_SetRoot(IDCompositionTarget *iface, IDCompositionVisual *root_iface)
+{
+    struct dcomp_target *target = impl_from_IDCompositionTarget(iface);
+    struct dcomp_visual *root = unsafe_impl_from_IDCompositionVisual(root_iface);
+
+    TRACE("iface %p, root %p.\n", iface, root_iface);
+
+    if (root_iface && (!root || root->device != target->device))
+        return E_INVALIDARG;
+
+    dcomp_device_lock(target->device);
+    if (root)
+        IDCompositionVisual3_AddRef(&root->IDCompositionVisual3_iface);
+    if (target->root)
+        IDCompositionVisual3_Release(&target->root->IDCompositionVisual3_iface);
+    target->root = root;
+    dcomp_device_unlock(target->device);
+    return S_OK;
+}
+
+static const struct IDCompositionTargetVtbl target_vtbl =
+{
+    target_QueryInterface,
+    target_AddRef,
+    target_Release,
+    target_SetRoot,
+};
+
+HRESULT dcomp_target_create(struct dcomp_device *device, HWND hwnd, BOOL topmost, IDCompositionTarget **out)
+{
+    struct dcomp_target *target;
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!IsWindow(hwnd))
+        return E_INVALIDARG;
+
+    if (!(target = calloc(1, sizeof(*target))))
+        return E_OUTOFMEMORY;
+
+    target->IDCompositionTarget_iface.lpVtbl = &target_vtbl;
+    target->refcount = 1;
+    target->device = device;
+    dcomp_device_add_ref(device);
+    target->hwnd = hwnd;
+    target->topmost = topmost;
+
+    dcomp_device_lock(device);
+    list_add_tail(&device->targets, &target->entry);
+    dcomp_device_unlock(device);
+
+    TRACE("Created target %p for window %p.\n", target, hwnd);
+    *out = &target->IDCompositionTarget_iface;
+    return S_OK;
+}
