+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "dcomp_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/* DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED */
+#define DCOMP_E_SURFACE_BEING_RENDERED  ((HRESULT)0x88980801)
+#define DCOMP_E_SURFACE_NOT_BEING_RENDERED ((HRESULT)0x88980802)
+
+static const struct IDCompositionVirtualSurfaceVtbl surface_vtbl;
+
+static inline struct dcomp_surface *impl_from_IDCompositionVirtualSurface(IDCompositionVirtualSurface *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_surface, IDCompositionVirtualSurface_iface);
+}
+
+struct dcomp_surface *unsafe_impl_from_IDCompositionSurface(IUnknown *iface)
+{
+    if (!iface || ((IDCompositionVirtualSurface *)iface)->lpVtbl != &surface_vtbl)
+        return NULL;
+    return impl_from_IDCompositionVirtualSurface((IDCompositionVirtualSurface *)iface);
+}
+
+static BOOL is_surface_format(DXGI_FORMAT format)
+{
+    switch (format)
+    {
+        case DXGI_FORMAT_B8G8R8A8_UNORM:
+        case DXGI_FORMAT_R8G8B8A8_UNORM:
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        case DXGI_FORMAT_A8_UNORM:
+            return TRUE;
+        default:
+            return FALSE;
+    }
+}
+
+static HRESULT create_texture(struct dcomp_surface *surface, ID3D11Device *d3d11_device, UINT width, UINT height,
+        ID3D11Texture2D **texture, ID3D11ShaderResourceView **view)
+{
+    D3D11_TEXTURE2D_DESC desc;
+    HRESULT hr;
+
+    desc.Width = max(width, 1);
+    desc.Height = max(height, 1);
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = surface->format;
+    desc.SampleDesc.Count = 1;
+    desc.SampleDesc.Quality = 0;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags = 0;
+
+    if (FAILED(hr = ID3D11Device_CreateTexture2D(d3d11_device, &desc, NULL, texture)))
+        return hr;
+    if (FAILED(hr = ID3D11Device_CreateShaderResourceView(d3d11_device, (ID3D11Resource *)*texture, NULL, view)))
+    {
+        ID3D11Texture2D_Release(*texture);
+        *texture = NULL;
+    }
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE surface_QueryInterface(IDCompositionVirtualSurface *iface, REFIID iid, void **out)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown)
+            || IsEqualGUID(iid, &IID_IDCompositionSurface)
+            || (surface->is_virtual && IsEqualGUID(iid, &IID_IDCompositionVirtualSurface)))
+    {
+        IDCompositionVirtualSurface_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE surface_AddRef(IDCompositionVirtualSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    ULONG refcount = InterlockedIncrement(&surface->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", surface, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE surface_Release(IDCompositionVirtualSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    ULONG refcount = InterlockedDecrement(&surface->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", surface, refcount);
+
+    if (!refcount)
+    {
+        ID3D11ShaderResourceView_Release(surface->view);
+        ID3D11Texture2D_Release(surface->texture);
+        dcomp_device_release(surface->device);
+        free(surface);
+    }
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE surface_BeginDraw(IDCompositionVirtualSurface *iface, const RECT *rect,
+        REFIID iid, void **object, POINT *offset)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    RECT update;
+    HRESULT hr;
+
+    TRACE("iface %p, rect %s, iid %s, object %p, offset %p.\n",
+            iface, wine_dbgstr_rect(rect), debugstr_guid(iid), object, offset);
+
+    if (!object || !offset)
+        return E_INVALIDARG;
+    *object = NULL;
+
+    SetRect(&update, 0, 0, surface->width, surface->height);
+    if (rect && !IntersectRect(&update, &update, rect))
+        return E_INVALIDARG;
+
+    dcomp_device_lock(surface->device);
+    if (surface->drawing)
+    {
+        dcomp_device_unlock(surface->device);
+        return DCOMP_E_SURFACE_BEING_RENDERED;
+    }
+
+    /* The whole surface is one texture. The caller draws the update
+     * rectangle at the returned offset, so that is the rectangle's own
+     * position, and everything outside it keeps its content. */
+    if (IsEqualGUID(iid, &IID_ID3D11Texture2D) || IsEqualGUID(iid, &IID_ID3D11Resource)
+            || IsEqualGUID(iid, &IID_IDXGISurface) || IsEqualGUID(iid, &IID_IDXGISurface1)
+            || IsEqualGUID(iid, &IID_IDXGISurface2) || IsEqualGUID(iid, &IID_IDXGIResource)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        hr = ID3D11Texture2D_QueryInterface(surface->texture, iid, object);
+    }
+    else
+    {
+        FIXME("Drawing with %s is not implemented.\n", debugstr_guid(iid));
+        hr = E_NOINTERFACE;
+    }
+
+    if (SUCCEEDED(hr))
+    {
+        offset->x = update.left;
+        offset->y = update.top;
+        surface->drawing = TRUE;
+    }
+    dcomp_device_unlock(surface->device);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE surface_EndDraw(IDCompositionVirtualSurface *iface)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p.\n", iface);
+
+    dcomp_device_lock(surface->device);
+    if (!surface->drawing)
+        hr = DCOMP_E_SURFACE_NOT_BEING_RENDERED;
+    surface->drawing = FALSE;
+    surface->has_content = TRUE;
+    dcomp_device_unlock(surface->device);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE surface_SuspendDraw(IDCompositionVirtualSurface *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    /* Drawing goes straight into the texture: nothing to hand over. */
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE surface_ResumeDraw(IDCompositionVirtualSurface *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE surface_Scroll(IDCompositionVirtualSurface *iface, const RECT *scroll_rect,
+        const RECT *clip_rect, int offset_x, int offset_y)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    ID3D11ShaderResourceView *tmp_view;
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *tmp;
+    RECT src, dst, clip;
+    D3D11_BOX box;
+    HRESULT hr;
+
+    TRACE("iface %p, scroll_rect %s, clip_rect %s, offset_x %d, offset_y %d.\n",
+            iface, wine_dbgstr_rect(scroll_rect), wine_dbgstr_rect(clip_rect), offset_x, offset_y);
+
+    SetRect(&src, 0, 0, surface->width, surface->height);
+    if (scroll_rect && !IntersectRect(&src, &src, scroll_rect))
+        return S_OK;
+    SetRect(&clip, 0, 0, surface->width, surface->height);
+    if (clip_rect && !IntersectRect(&clip, &clip, clip_rect))
+        return S_OK;
+    dst = src;
+    OffsetRect(&dst, offset_x, offset_y);
+    if (!IntersectRect(&dst, &dst, &clip))
+        return S_OK;
+    src = dst;
+    OffsetRect(&src, -offset_x, -offset_y);
+
+    dcomp_device_lock(surface->device);
+    /* Source and destination overlap: go through a copy. */
+    if (FAILED(hr = create_texture(surface, surface->device->d3d11_device, surface->width, surface->height,
+            &tmp, &tmp_view)))
+    {
+        dcomp_device_unlock(surface->device);
+        return hr;
+    }
+    ID3D11Device_GetImmediateContext(surface->device->d3d11_device, &context);
+    box.left = src.left;
+    box.top = src.top;
+    box.right = src.right;
+    box.bottom = src.bottom;
+    box.front = 0;
+    box.back = 1;
+    ID3D11DeviceContext_CopySubresourceRegion(context, (ID3D11Resource *)tmp, 0, src.left, src.top, 0,
+            (ID3D11Resource *)surface->texture, 0, &box);
+    ID3D11DeviceContext_CopySubresourceRegion(context, (ID3D11Resource *)surface->texture, 0, dst.left, dst.top, 0,
+            (ID3D11Resource *)tmp, 0, &box);
+    ID3D11DeviceContext_Release(context);
+    ID3D11ShaderResourceView_Release(tmp_view);
+    ID3D11Texture2D_Release(tmp);
+    dcomp_device_unlock(surface->device);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE surface_Resize(IDCompositionVirtualSurface *iface, UINT width, UINT height)
+{
+    struct dcomp_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    ID3D11ShaderResourceView *view;
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *texture;
+    D3D11_BOX box;
+    HRESULT hr;
+
+    TRACE("iface %p, width %u, height %u.\n", iface, width, height);
+
+    dcomp_device_lock(surface->device);
+    if (surface->drawing)
+    {
+        dcomp_device_unlock(surface->device);
+        return DCOMP_E_SURFACE_BEING_RENDERED;
+    }
+    if (FAILED(hr = create_texture(surface, surface->device->d3d11_device, width, height, &texture, &view)))
+    {
+        dcomp_device_unlock(surface->device);
+        return hr;
+    }
+
+    /* Keep what is still inside the new size. */
+    box.left = 0;
+    box.top = 0;
+    box.right = min(width, surface->width);
+    box.bottom = min(height, surface->height);
+    box.front = 0;
+    box.back = 1;
+    if (box.right && box.bottom)
+    {
+        ID3D11Device_GetImmediateContext(surface->device->d3d11_device, &context);
+        ID3D11DeviceContext_CopySubresourceRegion(context, (ID3D11Resource *)texture, 0, 0, 0, 0,
+                (ID3D11Resource *)surface->texture, 0, &box);
+        ID3D11DeviceContext_Release(context);
+    }
+
+    ID3D11ShaderResourceView_Release(surface->view);
+    ID3D11Texture2D_Release(surface->texture);
+    surface->texture = texture;
+    surface->view = view;
+    surface->width = width;
+    surface->height = height;
+    dcomp_device_unlock(surface->device);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE surface_Trim(IDCompositionVirtualSurface *iface, const RECT *rects, UINT count)
+{
+    TRACE("iface %p, rects %p, count %u.\n", iface, rects, count);
+
+    /* The texture covers the whole surface; nothing to give back. */
+    return S_OK;
+}
+
+static const struct IDCompositionVirtualSurfaceVtbl surface_vtbl =
+{
+    /* IUnknown methods */
+    surface_QueryInterface,
+    surface_AddRef,
+    surface_Release,
+    /* IDCompositionSurface methods */
+    surface_BeginDraw,
+    surface_EndDraw,
+    surface_SuspendDraw,
+    surface_ResumeDraw,
+    surface_Scroll,
+    /* IDCompositionVirtualSurface methods */
+    surface_Resize,
+    surface_Trim,
+};
+
+HRESULT dcomp_surface_create(struct dcomp_device *device, ID3D11Device *d3d11_device, UINT width, UINT height,
+        DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, BOOL is_virtual, IDCompositionVirtualSurface **out)
+{
+    struct dcomp_surface *surface;
+    HRESULT hr;
+
+    if (!width || !height || !is_surface_format(format))
+        return E_INVALIDARG;
+    if (alpha_mode != DXGI_ALPHA_MODE_PREMULTIPLIED && alpha_mode != DXGI_ALPHA_MODE_IGNORE)
+        return E_INVALIDARG;
+    if (d3d11_device != device->d3d11_device)
+    {
+        FIXME("Surfaces drawn with another D3D11 device than the composition device are not implemented.\n");
+        return E_NOTIMPL;
+    }
+
+    if (!(surface = calloc(1, sizeof(*surface))))
+        return E_OUTOFMEMORY;
+
+    surface->IDCompositionVirtualSurface_iface.lpVtbl = &surface_vtbl;
+    surface->refcount = 1;
+    surface->is_virtual = is_virtual;
+    surface->width = width;
+    surface->height = height;
+    surface->format = format;
+    surface->alpha_mode = alpha_mode;
+
+    if (FAILED(hr = create_texture(surface, d3d11_device, width, height, &surface->texture, &surface->view)))
+    {
+        WARN("Failed to create the surface texture, hr %#lx.\n", hr);
+        free(surface);
+        return hr;
+    }
+    surface->device = device;
+    dcomp_device_add_ref(device);
+
+    TRACE("Created surface %p, %ux%u, format %#x, alpha mode %#x.\n", surface, width, height, format, alpha_mode);
+    *out = &surface->IDCompositionVirtualSurface_iface;
+    return S_OK;
+}
+
+/* IDCompositionSurfaceFactory */
+
+struct dcomp_surface_factory
+{
+    IDCompositionSurfaceFactory IDCompositionSurfaceFactory_iface;
+    LONG refcount;
+    struct dcomp_device *device;
+    ID3D11Device *d3d11_device;
+};
+
+static inline struct dcomp_surface_factory *impl_from_IDCompositionSurfaceFactory(IDCompositionSurfaceFactory *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_surface_factory, IDCompositionSurfaceFactory_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE surface_factory_QueryInterface(IDCompositionSurfaceFactory *iface,
+        REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown)
+            || IsEqualGUID(iid, &IID_IDCompositionSurfaceFactory))
+    {
+        IDCompositionSurfaceFactory_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE surface_factory_AddRef(IDCompositionSurfaceFactory *iface)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    ULONG refcount = InterlockedIncrement(&factory->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", factory, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE surface_factory_Release(IDCompositionSurfaceFactory *iface)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    ULONG refcount = InterlockedDecrement(&factory->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", factory, refcount);
+
+    if (!refcount)
+    {
+        ID3D11Device_Release(factory->d3d11_device);
+        dcomp_device_release(factory->device);
+        free(factory);
+    }
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE surface_factory_CreateSurface(IDCompositionSurfaceFactory *iface,
+        UINT width, UINT height, DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, IDCompositionSurface **surface)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+
+    TRACE("iface %p, width %u, height %u, format %#x, alpha_mode %#x, surface %p.\n",
+            iface, width, height, format, alpha_mode, surface);
+
+    if (!surface)
+        return E_INVALIDARG;
+    return dcomp_surface_create(factory->device, factory->d3d11_device, width, height, format, alpha_mode,
+            FALSE, (IDCompositionVirtualSurface **)surface);
+}
+
+static HRESULT STDMETHODCALLTYPE surface_factory_CreateVirtualSurface(IDCompositionSurfaceFactory *iface,
+        UINT width, UINT height, DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode,
+        IDCompositionVirtualSurface **surface)
+{
+    struct dcomp_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+
+    TRACE("iface %p, width %u, height %u, format %#x, alpha_mode %#x, surface %p.\n",
+            iface, width, height, format, alpha_mode, surface);
+
+    if (!surface)
+        return E_INVALIDARG;
+    return dcomp_surface_create(factory->device, factory->d3d11_device, width, height, format, alpha_mode,
+            TRUE, surface);
+}
+
+static const struct IDCompositionSurfaceFactoryVtbl surface_factory_vtbl =
+{
+    surface_factory_QueryInterface,
+    surface_factory_AddRef,
+    surface_factory_Release,
+    surface_factory_CreateSurface,
+    surface_factory_CreateVirtualSurface,
+};
+
+HRESULT dcomp_surface_factory_create(struct dcomp_device *device, IUnknown *rendering_device,
+        IDCompositionSurfaceFactory **out)
+{
+    struct dcomp_surface_factory *factory;
+    ID3D11Device *d3d11_device;
+
+    if (!rendering_device || FAILED(IUnknown_QueryInterface(rendering_device, &IID_ID3D11Device,
+            (void **)&d3d11_device)))
+    {
+        FIXME("Surface factories for rendering device %p (not D3D11) are not implemented.\n", rendering_device);
+        return E_NOTIMPL;
+    }
+
+    if (!(factory = calloc(1, sizeof(*factory))))
+    {
+        ID3D11Device_Release(d3d11_device);
+        return E_OUTOFMEMORY;
+    }
+    factory->IDCompositionSurfaceFactory_iface.lpVtbl = &surface_factory_vtbl;
+    factory->refcount = 1;
+    factory->device = device;
+    dcomp_device_add_ref(device);
+    factory->d3d11_device = d3d11_device;
+
+    *out = &factory->IDCompositionSurfaceFactory_iface;
+    return S_OK;
+}
