+static HRESULT STDMETHODCALLTYPE composition_swapchain_GetLastPresentCount(IDXGISwapChain4 *iface,
+        UINT *last_present_count)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
