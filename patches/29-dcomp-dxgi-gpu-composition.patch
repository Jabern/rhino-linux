+static void remove_child(struct dcomp_visual *visual, SIZE_T index)
+{
+    struct dcomp_visual *child = visual->children[index];
+
+    memmove(&visual->children[index], &visual->children[index + 1],
+            (visual->child_count - index - 1) * sizeof(*visual->children));
+    --visual->child_count;
+    child->parent = NULL;
+    IDCompositionVisual3_Release(&child->IDCompositionVisual3_iface);
+}
