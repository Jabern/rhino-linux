+static SIZE_T find_child(struct dcomp_visual *visual, struct dcomp_visual *child)
+{
+    SIZE_T i;
+
+    for (i = 0; i < visual->child_count; ++i)
+    {
+        if (visual->children[i] == child)
+            return i;
+    }
+    return ~(SIZE_T)0;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_AddVisual(IDCompositionVisual3 *iface, IDCompositionVisual *child_iface,
+        BOOL insert_above, IDCompositionVisual *reference_iface)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual3(iface);
+    struct dcomp_visual *child = unsafe_impl_from_IDCompositionVisual(child_iface);
+    struct dcomp_visual *reference = unsafe_impl_from_IDCompositionVisual(reference_iface);
+    SIZE_T index;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, child %p, insert_above %d, reference %p.\n", iface, child_iface, insert_above, reference_iface);
+
+    if (!child || child == visual || (reference_iface && !reference))
+        return E_INVALIDARG;
+    if (child->device != visual->device)
+        return E_INVALIDARG;
+
+    dcomp_device_lock(visual->device);
+    if (child->parent)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
+    /* Children are kept bottom to top. Without a reference, "below no other"
+     * (insert_above FALSE) means on top, "above none" means at the bottom. */
+    if (reference)
+    {
+        if ((index = find_child(visual, reference)) == ~(SIZE_T)0)
+        {
+            hr = E_INVALIDARG;
+            goto done;
+        }
+        if (insert_above)
+            ++index;
+    }
+    else
+    {
+        index = insert_above ? 0 : visual->child_count;
+    }
+
+    if (!dcomp_array_reserve((void **)&visual->children, &visual->children_size,
+            visual->child_count + 1, sizeof(*visual->children)))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    memmove(&visual->children[index + 1], &visual->children[index],
+            (visual->child_count - index) * sizeof(*visual->children));
+    visual->children[index] = child;
+    ++visual->child_count;
+    child->parent = visual;
+    IDCompositionVisual3_AddRef(&child->IDCompositionVisual3_iface);
+
+done:
+    dcomp_device_unlock(visual->device);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_RemoveVisual(IDCompositionVisual3 *iface, IDCompositionVisual *child_iface)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual3(iface);
+    struct dcomp_visual *child = unsafe_impl_from_IDCompositionVisual(child_iface);
+    SIZE_T index;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, child %p.\n", iface, child_iface);
+
+    if (!child)
+        return E_INVALIDARG;
+
+    dcomp_device_lock(visual->device);
+    if ((index = find_child(visual, child)) == ~(SIZE_T)0)
+        hr = E_INVALIDARG;
+    else
+        remove_child(visual, index);
+    dcomp_device_unlock(visual->device);
+    return hr;
+}
