+static ULONG STDMETHODCALLTYPE target_AddRef(IDCompositionTarget *iface)
+{
+    struct dcomp_target *target = impl_from_IDCompositionTarget(iface);
+    ULONG refcount = InterlockedIncrement(&target->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", target, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE target_Release(IDCompositionTarget *iface)
+{
+    struct dcomp_target *target = impl_from_IDCompositionTarget(iface);
+    ULONG refcount = InterlockedDecrement(&target->refcount);
+    struct dcomp_device *device = target->device;
+
+    TRACE("%p decreasing refcount to %lu.\n", target, refcount);
+
+    if (!refcount)
+    {
+        dcomp_device_lock(device);
+        list_remove(&target->entry);
+        dcomp_compositor_release_target(target);
+        dcomp_device_unlock(device);
+        if (target->root)
+            IDCompositionVisual3_Release(&target->root->IDCompositionVisual3_iface);
+        if (target->committed_root)
+            IDCompositionVisual3_Release(&target->committed_root->IDCompositionVisual3_iface);
+        free(target);
+        dcomp_device_release(device);
+    }
+    return refcount;
+}
