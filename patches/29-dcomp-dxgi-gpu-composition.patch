+static HRESULT STDMETHODCALLTYPE wine_composition_get_front_buffer(IWineDXGICompositionSwapChain *iface,
+        IUnknown **texture, UINT *width, UINT *height, UINT64 *present_count)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IWineDXGICompositionSwapChain(iface);
+
+    TRACE("iface %p, texture %p, width %p, height %p, present_count %p.\n",
+            iface, texture, width, height, present_count);
+
+    *present_count = swapchain->present_count;
+    if (!swapchain->present_count || !swapchain->front_buffer)
+    {
+        *texture = NULL;
+        *width = *height = 0;
+        return S_FALSE;
+    }
+    *width = swapchain->front_width;
+    *height = swapchain->front_height;
+    *texture = (IUnknown *)swapchain->front_buffer;
+    IUnknown_AddRef(*texture);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE wine_composition_add_present_listener(IWineDXGICompositionSwapChain *iface,
+        void *callback, void *context)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IWineDXGICompositionSwapChain(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, callback %p, context %p.\n", iface, callback, context);
+
+    AcquireSRWLockExclusive(&swapchain->listeners_lock);
+    if (!array_reserve((void **)&swapchain->listeners, &swapchain->listeners_size,
+            swapchain->listener_count + 1, sizeof(*swapchain->listeners)))
+    {
+        hr = E_OUTOFMEMORY;
+    }
+    else
+    {
+        swapchain->listeners[swapchain->listener_count].callback = callback;
+        swapchain->listeners[swapchain->listener_count].context = context;
+        ++swapchain->listener_count;
+    }
+    ReleaseSRWLockExclusive(&swapchain->listeners_lock);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE wine_composition_remove_present_listener(IWineDXGICompositionSwapChain *iface,
+        void *context)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IWineDXGICompositionSwapChain(iface);
+    SIZE_T i;
+
+    TRACE("iface %p, context %p.\n", iface, context);
+
+    AcquireSRWLockExclusive(&swapchain->listeners_lock);
+    for (i = 0; i < swapchain->listener_count; ++i)
+    {
+        if (swapchain->listeners[i].context != context)
+            continue;
+        memmove(&swapchain->listeners[i], &swapchain->listeners[i + 1],
+                (swapchain->listener_count - i - 1) * sizeof(*swapchain->listeners));
+        --swapchain->listener_count;
+        break;
+    }
+    ReleaseSRWLockExclusive(&swapchain->listeners_lock);
+    return S_OK;
+}
