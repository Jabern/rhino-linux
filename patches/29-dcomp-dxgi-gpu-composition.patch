+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* A composition swap chain has no window: DirectComposition shows it as the
+ * content of a visual. Its buffers are plain D3D11 textures. Buffer 0 is the
+ * back buffer for the swap chain's whole life, as D3D11's buffer renaming
+ * makes it look to applications. Present copies the presented region into a
+ * separate front texture, which dcomp reads through
+ * IWineDXGICompositionSwapChain, and tells dcomp's listeners so it can
+ * compose the new frame, as DWM does without waiting for a Commit. */
+
+#define COBJMACROS
+#include "d3d11_4.h"
+#include "dxgi_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dxgi);
+
+struct present_listener
+{
+    void (*callback)(void *context);
+    void *context;
+};
+
+struct dxgi_composition_swapchain
+{
+    IDXGISwapChain4 IDXGISwapChain4_iface;
+    IWineDXGICompositionSwapChain IWineDXGICompositionSwapChain_iface;
+    LONG refcount;
+    struct wined3d_private_store private_store;
+
+    IWineDXGIFactory *factory;
+    IUnknown *device;
+    ID3D11Device *d3d11_device;
+    ID3D11DeviceContext *context;
+
+    DXGI_SWAP_CHAIN_DESC1 desc;
+    ID3D11Texture2D *back_buffer;
+    ID3D11Texture2D *front_buffer;     /* the last presented frame */
+    UINT front_width, front_height;     /* its source size */
+    UINT64 present_count;
+
+    HANDLE frame_latency_event;
+    UINT max_frame_latency;
+    DXGI_RGBA background_color;
+    DXGI_MODE_ROTATION rotation;
+    UINT source_width, source_height;
+    DXGI_MATRIX_3X2_F matrix;
+    DXGI_COLOR_SPACE_TYPE color_space;
+
+    SRWLOCK listeners_lock;
+    struct present_listener *listeners;
+    SIZE_T listener_count, listeners_size;
+};
+
+static inline struct dxgi_composition_swapchain *impl_from_IDXGISwapChain4(IDXGISwapChain4 *iface)
+{
+    return CONTAINING_RECORD(iface, struct dxgi_composition_swapchain, IDXGISwapChain4_iface);
+}
+
+static inline struct dxgi_composition_swapchain *impl_from_IWineDXGICompositionSwapChain(
+        IWineDXGICompositionSwapChain *iface)
+{
+    return CONTAINING_RECORD(iface, struct dxgi_composition_swapchain, IWineDXGICompositionSwapChain_iface);
+}
+
+static BOOL array_reserve(void **elements, SIZE_T *capacity, SIZE_T count, SIZE_T size)
+{
+    SIZE_T new_capacity;
+    void *new_elements;
+
+    if (count <= *capacity)
+        return TRUE;
+    new_capacity = max(*capacity * 2, max(count, 4));
+    if (!(new_elements = realloc(*elements, new_capacity * size)))
+        return FALSE;
+    *elements = new_elements;
+    *capacity = new_capacity;
+    return TRUE;
+}
+
+static BOOL is_composition_format(DXGI_FORMAT format)
+{
+    switch (format)
+    {
+        case DXGI_FORMAT_B8G8R8A8_UNORM:
+        case DXGI_FORMAT_R8G8B8A8_UNORM:
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        case DXGI_FORMAT_R10G10B10A2_UNORM:
+            return TRUE;
+        default:
+            return FALSE;
+    }
+}
+
+static HRESULT create_texture(struct dxgi_composition_swapchain *swapchain, UINT bind_flags, ID3D11Texture2D **texture)
+{
+    D3D11_TEXTURE2D_DESC desc;
+
+    desc.Width = swapchain->desc.Width;
+    desc.Height = swapchain->desc.Height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = swapchain->desc.Format;
+    desc.SampleDesc.Count = 1;
+    desc.SampleDesc.Quality = 0;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = bind_flags;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags = 0;
+
+    return ID3D11Device_CreateTexture2D(swapchain->d3d11_device, &desc, NULL, texture);
+}
+
+static void release_buffers(struct dxgi_composition_swapchain *swapchain)
+{
+    if (swapchain->back_buffer)
+        ID3D11Texture2D_Release(swapchain->back_buffer);
+    if (swapchain->front_buffer)
+        ID3D11Texture2D_Release(swapchain->front_buffer);
+    swapchain->back_buffer = NULL;
+    swapchain->front_buffer = NULL;
+}
+
+static HRESULT create_back_buffer(struct dxgi_composition_swapchain *swapchain)
+{
+    UINT bind_flags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+
+    if (swapchain->desc.BufferUsage & DXGI_USAGE_UNORDERED_ACCESS)
+        bind_flags |= D3D11_BIND_UNORDERED_ACCESS;
+    return create_texture(swapchain, bind_flags, &swapchain->back_buffer);
+}
+
+/* The front buffer is created at the first present after creation or a resize, so
+ * that the last frame stays shown until then. */
+static BOOL front_buffer_matches(struct dxgi_composition_swapchain *swapchain)
+{
+    D3D11_TEXTURE2D_DESC desc;
+
+    if (!swapchain->front_buffer)
+        return FALSE;
+    ID3D11Texture2D_GetDesc(swapchain->front_buffer, &desc);
+    return desc.Width == swapchain->desc.Width && desc.Height == swapchain->desc.Height
+            && desc.Format == swapchain->desc.Format;
+}
+
+/* IDXGISwapChain4 */
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_QueryInterface(IDXGISwapChain4 *iface, REFIID iid, void **out)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown)
+            || IsEqualGUID(iid, &IID_IDXGIObject)
+            || IsEqualGUID(iid, &IID_IDXGIDeviceSubObject)
+            || IsEqualGUID(iid, &IID_IDXGISwapChain)
+            || IsEqualGUID(iid, &IID_IDXGISwapChain1)
+            || IsEqualGUID(iid, &IID_IDXGISwapChain2)
+            || IsEqualGUID(iid, &IID_IDXGISwapChain3)
+            || IsEqualGUID(iid, &IID_IDXGISwapChain4))
+    {
+        IUnknown_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    if (IsEqualGUID(iid, &IID_IWineDXGICompositionSwapChain))
+    {
+        IUnknown_AddRef(iface);
+        *out = &swapchain->IWineDXGICompositionSwapChain_iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE composition_swapchain_AddRef(IDXGISwapChain4 *iface)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+    ULONG refcount = InterlockedIncrement(&swapchain->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", swapchain, refcount);
+
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE composition_swapchain_Release(IDXGISwapChain4 *iface)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+    ULONG refcount = InterlockedDecrement(&swapchain->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", swapchain, refcount);
+
+    if (!refcount)
+    {
+        release_buffers(swapchain);
+        if (swapchain->frame_latency_event)
+            CloseHandle(swapchain->frame_latency_event);
+        free(swapchain->listeners);
+        ID3D11DeviceContext_Release(swapchain->context);
+        ID3D11Device_Release(swapchain->d3d11_device);
+        IUnknown_Release(swapchain->device);
+        IWineDXGIFactory_Release(swapchain->factory);
+        wined3d_private_store_cleanup(&swapchain->private_store);
+        free(swapchain);
+    }
+
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_SetPrivateData(IDXGISwapChain4 *iface,
+        REFGUID guid, UINT data_size, const void *data)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, guid %s, data_size %u, data %p.\n", iface, debugstr_guid(guid), data_size, data);
+
+    return dxgi_set_private_data(&swapchain->private_store, guid, data_size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_SetPrivateDataInterface(IDXGISwapChain4 *iface,
+        REFGUID guid, const IUnknown *object)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, guid %s, object %p.\n", iface, debugstr_guid(guid), object);
+
+    return dxgi_set_private_data_interface(&swapchain->private_store, guid, object);
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_GetPrivateData(IDXGISwapChain4 *iface,
+        REFGUID guid, UINT *data_size, void *data)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, guid %s, data_size %p, data %p.\n", iface, debugstr_guid(guid), data_size, data);
+
+    return dxgi_get_private_data(&swapchain->private_store, guid, data_size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_GetParent(IDXGISwapChain4 *iface, REFIID iid, void **parent)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, iid %s, parent %p.\n", iface, debugstr_guid(iid), parent);
+
+    return IWineDXGIFactory_QueryInterface(swapchain->factory, iid, parent);
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_GetDevice(IDXGISwapChain4 *iface, REFIID iid, void **device)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, iid %s, device %p.\n", iface, debugstr_guid(iid), device);
+
+    return IUnknown_QueryInterface(swapchain->device, iid, device);
+}
+
+static void notify_present_listeners(struct dxgi_composition_swapchain *swapchain)
+{
+    SIZE_T i;
+
+    /* The lock stays held during the callbacks, so remove_present_listener()
+     * returns only once no callback for that listener runs any more and its
+     * owner can go away. Callbacks must not wait for a lock their owner holds
+     * while removing a listener, nor add or remove listeners themselves. */
+    AcquireSRWLockShared(&swapchain->listeners_lock);
+    for (i = 0; i < swapchain->listener_count; ++i)
+        swapchain->listeners[i].callback(swapchain->listeners[i].context);
+    ReleaseSRWLockShared(&swapchain->listeners_lock);
+}
+
+static HRESULT copy_presented_region(struct dxgi_composition_swapchain *swapchain,
+        const DXGI_PRESENT_PARAMETERS *params)
+{
+    BOOL new_front = FALSE;
+    D3D11_BOX box;
+    HRESULT hr;
+    UINT i;
+
+    if (!front_buffer_matches(swapchain))
+    {
+        ID3D11Texture2D *front;
+
+        if (FAILED(hr = create_texture(swapchain, D3D11_BIND_SHADER_RESOURCE, &front)))
+            return hr;
+        if (swapchain->front_buffer)
+            ID3D11Texture2D_Release(swapchain->front_buffer);
+        swapchain->front_buffer = front;
+        new_front = TRUE;
+    }
+
+    /* A new front buffer, a scroll, or no dirty rectangles: copy everything. */
+    if (new_front || !params || !params->DirtyRectsCount
+            || params->pScrollRect || !params->pDirtyRects)
+    {
+        ID3D11DeviceContext_CopyResource(swapchain->context,
+                (ID3D11Resource *)swapchain->front_buffer, (ID3D11Resource *)swapchain->back_buffer);
+        return S_OK;
+    }
+
+    for (i = 0; i < params->DirtyRectsCount; ++i)
+    {
+        const RECT *r = &params->pDirtyRects[i];
+
+        box.left = max(r->left, 0);
+        box.top = max(r->top, 0);
+        box.right = min(r->right, (LONG)swapchain->desc.Width);
+        box.bottom = min(r->bottom, (LONG)swapchain->desc.Height);
+        box.front = 0;
+        box.back = 1;
+        if (box.left >= box.right || box.top >= box.bottom)
+            continue;
+        ID3D11DeviceContext_CopySubresourceRegion(swapchain->context, (ID3D11Resource *)swapchain->front_buffer,
+                0, box.left, box.top, 0, (ID3D11Resource *)swapchain->back_buffer, 0, &box);
+    }
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_Present1(IDXGISwapChain4 *iface,
+        UINT sync_interval, UINT flags, const DXGI_PRESENT_PARAMETERS *params)
+{
+    HRESULT hr;
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, sync_interval %u, flags %#x, params %p.\n", iface, sync_interval, flags, params);
+
+    if (sync_interval > 4)
+        return DXGI_ERROR_INVALID_CALL;
+    if (flags & DXGI_PRESENT_TEST)
+        return S_OK;
+
+    /* Composition swap chains are presented by the compositor: do not wait
+     * for vertical blank here, DWM does not block the caller either. */
+    if (FAILED(hr = copy_presented_region(swapchain, params)))
+    {
+        ERR("Failed to create the front buffer, hr %#lx.\n", hr);
+        return hr;
+    }
+    swapchain->front_width = swapchain->source_width ? swapchain->source_width : swapchain->desc.Width;
+    swapchain->front_height = swapchain->source_height ? swapchain->source_height : swapchain->desc.Height;
+    InterlockedIncrement64((LONG64 *)&swapchain->present_count);
+    if (swapchain->frame_latency_event)
+        SetEvent(swapchain->frame_latency_event);
+
+    notify_present_listeners(swapchain);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_Present(IDXGISwapChain4 *iface, UINT sync_interval, UINT flags)
+{
+    TRACE("iface %p, sync_interval %u, flags %#x.\n", iface, sync_interval, flags);
+
+    return composition_swapchain_Present1(iface, sync_interval, flags, NULL);
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_GetBuffer(IDXGISwapChain4 *iface,
+        UINT index, REFIID iid, void **surface)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, index %u, iid %s, surface %p.\n", iface, index, debugstr_guid(iid), surface);
+
+    if (index >= swapchain->desc.BufferCount)
+        return DXGI_ERROR_INVALID_CALL;
+
+    /* Every buffer index refers to the back buffer, as after D3D11 renaming. */
+    return ID3D11Texture2D_QueryInterface(swapchain->back_buffer, iid, surface);
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_SetFullscreenState(IDXGISwapChain4 *iface,
+        BOOL fullscreen, IDXGIOutput *target)
+{
+    TRACE("iface %p, fullscreen %d, target %p.\n", iface, fullscreen, target);
+
+    return fullscreen ? DXGI_ERROR_INVALID_CALL : S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_GetFullscreenState(IDXGISwapChain4 *iface,
+        BOOL *fullscreen, IDXGIOutput **target)
+{
+    TRACE("iface %p, fullscreen %p, target %p.\n", iface, fullscreen, target);
+
+    if (fullscreen)
+        *fullscreen = FALSE;
+    if (target)
+        *target = NULL;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_GetDesc(IDXGISwapChain4 *iface, DXGI_SWAP_CHAIN_DESC *desc)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+
+    TRACE("iface %p, desc %p.\n", iface, desc);
+
+    if (!desc)
+        return E_INVALIDARG;
+
+    memset(desc, 0, sizeof(*desc));
+    desc->BufferDesc.Width = swapchain->desc.Width;
+    desc->BufferDesc.Height = swapchain->desc.Height;
+    desc->BufferDesc.Format = swapchain->desc.Format;
+    desc->SampleDesc = swapchain->desc.SampleDesc;
+    desc->BufferUsage = swapchain->desc.BufferUsage;
+    desc->BufferCount = swapchain->desc.BufferCount;
+    desc->OutputWindow = NULL;
+    desc->Windowed = TRUE;
+    desc->SwapEffect = swapchain->desc.SwapEffect;
+    desc->Flags = swapchain->desc.Flags;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_ResizeBuffers1(IDXGISwapChain4 *iface,
+        UINT buffer_count, UINT width, UINT height, DXGI_FORMAT format, UINT flags,
+        const UINT *node_mask, IUnknown * const *present_queue)
+{
+    struct dxgi_composition_swapchain *swapchain = impl_from_IDXGISwapChain4(iface);
+    DXGI_SWAP_CHAIN_DESC1 old_desc = swapchain->desc;
+    ID3D11Texture2D *back_buffer;
+    HRESULT hr;
+
+    TRACE("iface %p, buffer_count %u, width %u, height %u, format %s, flags %#x, node_mask %p, present_queue %p.\n",
+            iface, buffer_count, width, height, debug_dxgi_format(format), flags, node_mask, present_queue);
+
+    if (buffer_count)
+        swapchain->desc.BufferCount = buffer_count;
+    /* There is no window to take a size from: zero keeps the current one. */
+    if (width)
+        swapchain->desc.Width = width;
+    if (height)
+        swapchain->desc.Height = height;
+    if (format != DXGI_FORMAT_UNKNOWN)
+    {
+        if (!is_composition_format(format))
+        {
+            swapchain->desc = old_desc;
+            return DXGI_ERROR_INVALID_CALL;
+        }
+        swapchain->desc.Format = format;
+    }
+    swapchain->desc.Flags = flags;
+
+    /* Only the back buffer changes; the last frame stays shown until the next present. */
+    back_buffer = swapchain->back_buffer;
+    swapchain->back_buffer = NULL;
+    if (FAILED(hr = create_back_buffer(swapchain)))
+    {
+        ERR("Failed to resize the composition buffers, hr %#lx.\n", hr);
+        swapchain->desc = old_desc;
+        swapchain->back_buffer = back_buffer;
+        return hr;
+    }
+    ID3D11Texture2D_Release(back_buffer);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_ResizeBuffers(IDXGISwapChain4 *iface,
+        UINT buffer_count, UINT width, UINT height, DXGI_FORMAT format, UINT flags)
+{
+    TRACE("iface %p, buffer_count %u, width %u, height %u, format %s, flags %#x.\n",
+            iface, buffer_count, width, height, debug_dxgi_format(format), flags);
+
+    return composition_swapchain_ResizeBuffers1(iface, buffer_count, width, height, format, flags, NULL, NULL);
+}
+
+static HRESULT STDMETHODCALLTYPE composition_swapchain_ResizeTarget(IDXGISwapChain4 *iface,
+        const DXGI_MODE_DESC *target_mode_desc)
+{
+    TRACE("iface %p, target_mode_desc %p.\n", iface, target_mode_desc);
+
+    return DXGI_ERROR_INVALID_CALL;
+}
+
