+static ULONG STDMETHODCALLTYPE visual_AddRef(IDCompositionVisual3 *iface)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual3(iface);
+    ULONG refcount = InterlockedIncrement(&visual->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", visual, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE visual_Release(IDCompositionVisual3 *iface)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual3(iface);
+    ULONG refcount = InterlockedDecrement(&visual->refcount);
+    struct dcomp_device *device = visual->device;
+
+    TRACE("%p decreasing refcount to %lu.\n", visual, refcount);
+
+    if (!refcount)
+    {
+        dcomp_device_lock(device);
+        list_remove(&visual->entry);
+        while (visual->child_count)
+            remove_child(visual, visual->child_count - 1);
+        free(visual->children);
+        release_state(&visual->committed);
+        dcomp_device_unlock(device);
+
+        if (visual->content)
+            IUnknown_Release(visual->content);
+        if (visual->transform_object)
+            IUnknown_Release(visual->transform_object);
+        if (visual->effect)
+            IDCompositionEffect_Release(visual->effect);
+        if (visual->clip_object)
+            IDCompositionClip_Release(visual->clip_object);
+        dcomp_value_cleanup(&visual->offset_x);
+        dcomp_value_cleanup(&visual->offset_y);
+        dcomp_value_cleanup(&visual->opacity);
+        free(visual);
+        dcomp_device_release(device);
+    }
+    return refcount;
+}
