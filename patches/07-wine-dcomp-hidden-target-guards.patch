+/* A DComp target may be hidden by design (visual hosting composites onto its
+ * visible owner), so only the ancestors decide whether drawing is allowed.
+ * Top-level windows must be visible themselves. */
+static BOOL dcomp_target_ancestors_visible( HWND hwnd )
+{
+    HWND parent = GetAncestor( hwnd, GA_PARENT );
+    if (!parent || parent == GetDesktopWindow()) return IsWindowVisible( hwnd );
+    return IsWindowVisible( parent );
+}
