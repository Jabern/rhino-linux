+/* Do not copy composition content to a window that is not effectively
+ * visible (hidden itself or through a hidden ancestor): its retained DC
+ * clipping can be stale after a cross-process ancestor hide and the copy
+ * would paint over other UI. The composition buffer is still updated so
+ * the content is ready when the window becomes visible again. */
+static BOOL swapchain_window_visible( const struct wined3d_swapchain *swapchain )
+{
+    HWND parent;
+
+    if (!swapchain->win_handle) return FALSE;
+    /* A swapchain window may be hidden by design (composited onto a visible
+     * owner), so only the ancestors decide. Top-levels must be visible. */
+    if ((parent = GetAncestor( swapchain->win_handle, GA_PARENT )) && parent != GetDesktopWindow())
+        return IsWindowVisible( parent );
+    return IsWindowVisible( swapchain->win_handle );
+}
+
 static void swapchain_blit_gdi(struct wined3d_swapchain *swapchain,
         struct wined3d_context *context, const RECT *src_rect, const RECT *dst_rect)
 {
