-                    swapchain->comp_dc, 0, 0, SRCCOPY);
+            if (swapchain_window_visible( swapchain ))
+                BitBlt(swapchain->dc, dst_rect->left, dst_rect->top, dst_w, dst_h,
+                        swapchain->comp_dc, 0, 0, SRCCOPY);
