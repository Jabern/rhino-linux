+/* Keep a copy of the frame just shown: the X server discards the contents of an offscreen
+ * window when it is unmapped with its toplevel window, e.g. when it is minimized. */
+static void client_surface_save_last_frame( struct x11drv_client_surface *surface, int width, int height )
+{
+    GC gc;
+
+    if (width <= 0 || height <= 0) return;
+    if (!surface->last_frame || surface->last_frame_size.cx != width || surface->last_frame_size.cy != height)
+    {
+        if (surface->last_frame) XFreePixmap( gdi_display, surface->last_frame );
+        surface->last_frame = XCreatePixmap( gdi_display, surface->window, width, height, surface->depth );
+        surface->last_frame_size.cx = width;
+        surface->last_frame_size.cy = height;
+    }
+    if (!surface->last_frame) return;
+    gc = XCreateGC( gdi_display, surface->last_frame, 0, NULL );
+    XCopyArea( gdi_display, surface->window, surface->last_frame, gc, 0, 0, width, height, 0, 0 );
+    XFreeGC( gdi_display, gc );
+}
