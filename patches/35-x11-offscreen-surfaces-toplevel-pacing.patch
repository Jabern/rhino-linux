+/* Offscreen client windows are redirected, and their frames copied on-screen by us. Xwayland
+ * paces presents with the frame callbacks of a window's top-level window, and presents to a
+ * window outside any that is shown (the dummy parent) with a 17 ms timer, so vsync ran at about
+ * 60 Hz whatever the monitor's refresh rate. Keep them in an invisible window inside their
+ * top-level window instead, when it is ours. */
+static Window create_offscreen_parent( Window parent )
+{
+#ifdef HAVE_LIBXSHAPE
+    static XRectangle empty_rect;
+    XSetWindowAttributes attrib;
+    Window ret;
+
+    attrib.border_pixel = 0;
+    attrib.colormap = default_colormap;
+    ret = XCreateWindow( gdi_display, parent, 0, 0, 1, 1, 0, default_visual.depth, InputOutput,
+                         default_visual.visual, CWColormap | CWBorderPixel, &attrib );
+    if (!ret) return 0;
+    XShapeCombineRectangles( gdi_display, ret, ShapeBounding, 0, 0, &empty_rect, 1, ShapeSet, YXBanded );
+    XShapeCombineRectangles( gdi_display, ret, ShapeInput, 0, 0, &empty_rect, 1, ShapeSet, YXBanded );
+    XMapWindow( gdi_display, ret );
+    return ret;
+#else
+    return 0;
+#endif
+}
+
+static Window get_offscreen_parent( HWND hwnd )
+{
+    HWND top = NtUserGetAncestor( hwnd, GA_ROOT );
+    struct x11drv_win_data *data;
+    Window ret = 0;
+
+    if (top && (data = get_win_data( top )))
+    {
+        if (!data->offscreen_parent && data->whole_window && data->whole_window != root_window)
+        {
+            XFlush( data->display ); /* make sure whole_window is known from gdi_display */
+            data->offscreen_parent = create_offscreen_parent( data->whole_window );
+            TRACE( "%p/%lx offscreen parent %lx\n", top, data->whole_window, data->offscreen_parent );
+        }
+        ret = data->offscreen_parent;
+        release_win_data( data );
+    }
+    return ret ? ret : get_dummy_parent();
+}
