+
+static BOOL get_shared_window_tree( HWND hwnd, struct window_tree *tree )
+{
+    struct object_lock lock = OBJECT_LOCK_INIT;
+    const window_shm_t *window_shm = NULL;
+    struct user_entry entry;
+    NTSTATUS status;
+    HANDLE full;
+
+    if (!get_user_entry( hwnd, NTUSER_OBJ_WINDOW, &entry, &full ))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    while ((status = get_shared_window( hwnd, &lock, &window_shm )) == STATUS_PENDING)
+    {
+        tree->parent      = wine_server_ptr_handle( window_shm->parent );
+        tree->owner       = wine_server_ptr_handle( window_shm->owner );
+        tree->next        = wine_server_ptr_handle( window_shm->next_sibling );
+        tree->prev        = wine_server_ptr_handle( window_shm->prev_sibling );
+        tree->first_child = wine_server_ptr_handle( window_shm->first_child );
+        tree->last_child  = wine_server_ptr_handle( window_shm->last_child );
+    }
+    if (status)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    tree->full = full;
+    return TRUE;
+}
