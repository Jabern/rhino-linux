+/***********************************************************************
+ *           get_ancestors_clip
+ *
+ * Child windows with a surface of their own are composed into their ancestors,
+ * clipped to the client area of each, which may belong to other processes.
+ * Return that clip relative to the visible rect, or 0 if nothing is clipped.
+ */
+static HRGN get_ancestors_clip( HWND hwnd )
+{
+    struct ratio dpi = get_dpi_for_window( hwnd );
+    HWND parent = hwnd, desktop = get_desktop_window();
+    struct window_rects rects;
+    POINT offset = {0, 0};
+    RECT visible, clip, client;
+
+    if (!get_window_rects( hwnd, COORDS_PARENT, &rects, dpi )) return 0;
+    clip = visible = rects.visible;
+
+    /* clip is in the client coordinates of parent, offset is the origin of that client area */
+    while ((parent = NtUserGetAncestor( parent, GA_PARENT )) && parent != desktop)
+    {
+        if (!get_window_rects( parent, COORDS_PARENT, &rects, dpi )) return 0;
+        SetRect( &client, 0, 0, rects.client.right - rects.client.left, rects.client.bottom - rects.client.top );
+        if (!intersect_rect( &clip, &clip, &client )) SetRectEmpty( &clip );
+        OffsetRect( &clip, rects.client.left, rects.client.top );
+        offset.x += rects.client.left;
+        offset.y += rects.client.top;
+    }
+
+    OffsetRect( &clip, -offset.x - visible.left, -offset.y - visible.top );
+    if (!clip.left && !clip.top && clip.right == visible.right - visible.left &&
+        clip.bottom == visible.bottom - visible.top)
+        return 0;
+    return NtGdiCreateRectRgn( clip.left, clip.top, clip.right, clip.bottom );
+}
