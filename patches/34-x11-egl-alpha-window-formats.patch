+static BOOL egl_config_visual( EGLConfig config, XVisualInfo *visual )
+{
+    XVisualInfo *visuals;
+    int count;
+
+    memset( visual, 0, sizeof(*visual) );
+    funcs->p_eglGetConfigAttrib( egl->display, config, EGL_NATIVE_VISUAL_ID, (EGLint *)&visual->visualid );
+    if (!(visuals = XGetVisualInfo( gdi_display, VisualIDMask, visual, &count ))) return FALSE;
+    *visual = *visuals;
+    XFree( visuals );
+    return TRUE;
+}
+
+/* Index of a config with the screen depth that windows of a config can be created with: the config
+ * itself, or one with the same color sizes when its visual has another depth. Drivers often only
+ * offer configs with an alpha channel on a 32-bit ARGB visual; child windows with such a visual
+ * could not be copied on-screen with XCopyArea(), so their windows are created with a config
+ * without alpha and win32u renders into a framebuffer of the requested format. */
+static int egl_window_config_index( int index )
+{
+    static int *window_index;
+    EGLint type, size[3], other[3], samples, best_samples = 0;
+    XVisualInfo visual;
+    int i, ret = -1;
+
+    if (!window_index)
+    {
+        int *indices = malloc( egl->config_count * sizeof(*indices) );
+        if (!indices) return index;
+        for (i = 0; i < egl->config_count; i++) indices[i] = -2;
+        if (InterlockedCompareExchangePointer( (void **)&window_index, indices, NULL )) free( indices );
+    }
+    if (window_index[index] != -2) return window_index[index];
+
+    if (egl_config_visual( egl->configs[index], &visual ) && visual.depth == default_visual.depth) ret = index;
+    else
+    {
+        funcs->p_eglGetConfigAttrib( egl->display, egl->configs[index], EGL_RED_SIZE, &size[0] );
+        funcs->p_eglGetConfigAttrib( egl->display, egl->configs[index], EGL_GREEN_SIZE, &size[1] );
+        funcs->p_eglGetConfigAttrib( egl->display, egl->configs[index], EGL_BLUE_SIZE, &size[2] );
+
+        for (i = 0; i < egl->config_count; i++)
+        {
+            funcs->p_eglGetConfigAttrib( egl->display, egl->configs[i], EGL_SURFACE_TYPE, &type );
+            if (!(type & EGL_WINDOW_BIT)) continue;
+            funcs->p_eglGetConfigAttrib( egl->display, egl->configs[i], EGL_RED_SIZE, &other[0] );
+            funcs->p_eglGetConfigAttrib( egl->display, egl->configs[i], EGL_GREEN_SIZE, &other[1] );
+            funcs->p_eglGetConfigAttrib( egl->display, egl->configs[i], EGL_BLUE_SIZE, &other[2] );
+            if (memcmp( size, other, sizeof(size) )) continue;
+            if (!egl_config_visual( egl->configs[i], &visual ) || visual.depth != default_visual.depth) continue;
+            /* the framebuffer is multisampled itself, the window doesn't need to be */
+            funcs->p_eglGetConfigAttrib( egl->display, egl->configs[i], EGL_SAMPLES, &samples );
+            if (ret == -1 || samples < best_samples)
+            {
+                ret = i;
+                best_samples = samples;
+            }
+        }
+        TRACE( "config %d, depth %d: windows use config %d\n", index, visual.depth, ret );
+    }
+
+    window_index[index] = ret;
+    return ret;
+}
+
+/* The format windows of a pixel format are created with, or 0 if none can be */
+static int egl_window_format( int format )
+{
+    int index = (format - 1) % egl->config_count, window_index = egl_window_config_index( index );
+    if (window_index < 0) return 0;
+    return format - index + window_index;
+}
