+
+static DWORD WINAPI services_marshal_thread( void *arg )
+{
+    IUnknown *unknown;
+    IWbemServices *services;
+    IEnumWbemClassObject *result;
+    BSTR language, query;
+    HRESULT hr;
+
+    hr = CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+    ok( hr == S_OK, "Got %#lx.\n", hr );
+    if (FAILED(hr)) return 0;
+    hr = CoGetInterfaceAndReleaseStream( arg, &IID_IUnknown, (void **)&unknown );
+    ok( hr == S_OK, "Got %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = IUnknown_QueryInterface( unknown, &IID_IWbemServices, (void **)&services );
+        ok( hr == S_OK, "Cross-apartment QueryInterface failed: %#lx.\n", hr );
+        if (SUCCEEDED(hr))
+        {
+            language = SysAllocString( L"WQL" );
+            query = SysAllocString( L"SELECT Caption FROM Win32_OperatingSystem" );
+            hr = IWbemServices_ExecQuery( services, language, query, WBEM_FLAG_FORWARD_ONLY, NULL, &result );
+            ok( hr == S_OK, "Cross-apartment ExecQuery failed: %#lx.\n", hr );
+            if (SUCCEEDED(hr)) IEnumWbemClassObject_Release( result );
+            SysFreeString( query );
+            SysFreeString( language );
+            IWbemServices_Release( services );
+        }
+        IUnknown_Release( unknown );
+    }
+    CoUninitialize();
+    return 0;
+}
+
+static void test_services_marshal(void)
+{
+    IWbemLocator *locator;
+    IWbemServices *services;
+    IStream *stream;
+    BSTR path;
+    HANDLE thread;
+    HRESULT hr;
+
+    hr = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    ok( hr == S_OK, "Got %#lx.\n", hr );
+    if (FAILED(hr)) return;
+    hr = CoCreateInstance( &CLSID_WbemLocator, NULL, CLSCTX_INPROC_SERVER, &IID_IWbemLocator, (void **)&locator );
+    if (FAILED(hr))
+    {
+        win_skip( "Cannot create WbemLocator: %#lx.\n", hr );
+        CoUninitialize();
+        return;
+    }
+    path = SysAllocString( L"ROOT\\CIMV2" );
+    hr = IWbemLocator_ConnectServer( locator, path, NULL, NULL, NULL, 0, NULL, NULL, &services );
+    SysFreeString( path );
+    ok( hr == S_OK, "Got %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = CoMarshalInterThreadInterfaceInStream( &IID_IUnknown, (IUnknown *)services, &stream );
+        ok( hr == S_OK, "Got %#lx.\n", hr );
+        if (SUCCEEDED(hr))
+        {
+            thread = CreateThread( NULL, 0, services_marshal_thread, stream, 0, NULL );
+            ok( !!thread, "CreateThread failed: %lu.\n", GetLastError() );
+            if (thread)
+            {
+                WaitForSingleObject( thread, INFINITE );
+                CloseHandle( thread );
+            }
+            else
+            {
+                CoReleaseMarshalData( stream );
+                IStream_Release( stream );
+            }
+        }
+        IWbemServices_Release( services );
+    }
+    IWbemLocator_Release( locator );
+    CoUninitialize();
+}
+
 START_TEST(services)
 {
     CoInitialize( NULL );
@@ -293,4 +376,5 @@ START_TEST(services)
     test_IWbemContext();
     test_namespaces();
     CoUninitialize();
+    test_services_marshal();
 }
