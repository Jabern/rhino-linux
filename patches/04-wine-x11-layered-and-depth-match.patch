+#ifdef SONAME_LIBXDAMAGE
+static typeof(XDamageQueryExtension) *pXDamageQueryExtension;
+static typeof(XDamageQueryVersion) *pXDamageQueryVersion;
+static typeof(XDamageCreate) *pXDamageCreate;
+static typeof(XDamageDestroy) *pXDamageDestroy;
+static typeof(XDamageSubtract) *pXDamageSubtract;
+static pthread_once_t damage_once = PTHREAD_ONCE_INIT;
+static XContext damage_context;
+static BOOL damage_available;
+
+static BOOL client_surface_damage_notify( HWND unused, XEvent *event )
+{
+    XDamageNotifyEvent *damage = (XDamageNotifyEvent *)event;
+    struct x11drv_win_data *data;
+    HWND hwnd;
+
+    /* The context contains a handle, not a surface pointer: a queued event
+     * may outlive its drawable. Acknowledge before copying so a concurrent
+     * presentation generates another notification. */
+    if (XFindContext( event->xany.display, damage->damage, damage_context, (char **)&hwnd )) return FALSE;
+    if (!(data = get_win_data( hwnd ))) return FALSE;
+    if (XFindContext( event->xany.display, damage->damage, damage_context, (char **)&hwnd ))
+    {
+        release_win_data( data );
+        return FALSE;
+    }
+    pXDamageSubtract( event->xany.display, damage->damage, None, None );
+    XFlush( event->xany.display );
+    release_win_data( data );
+    TRACE( "damage %lx drawable %lx hwnd %p\n", damage->damage, damage->drawable, hwnd );
+    present_client_surfaces( hwnd );
+    return TRUE;
+}
+
+static void init_client_surface_damage(void)
+{
+    void *handle;
+    int event_base, error_base, major = 1, minor = 1;
+
+    if (!(handle = dlopen( SONAME_LIBXDAMAGE, RTLD_NOW ))) return;
+#define LOAD_DAMAGE_FUNC(f) if (!(p##f = dlsym( handle, #f ))) goto failed
+    LOAD_DAMAGE_FUNC(XDamageQueryExtension);
+    LOAD_DAMAGE_FUNC(XDamageQueryVersion);
+    LOAD_DAMAGE_FUNC(XDamageCreate);
+    LOAD_DAMAGE_FUNC(XDamageDestroy);
+    LOAD_DAMAGE_FUNC(XDamageSubtract);
+#undef LOAD_DAMAGE_FUNC
+    if (!pXDamageQueryExtension( gdi_display, &event_base, &error_base )) goto failed;
+    if (!pXDamageQueryVersion( gdi_display, &major, &minor )) goto failed;
+    damage_context = XUniqueContext();
+    X11DRV_register_event_handler( event_base + XDamageNotify, client_surface_damage_notify, "DamageNotify" );
+    damage_available = TRUE;
+    return;
+failed:
+    dlclose( handle );
+}
+
+static int damage_error_handler( Display *display, XErrorEvent *event, void *arg )
+{
+    return 1;
+}
+
+static void client_surface_set_damage( struct x11drv_client_surface *surface, BOOL enable )
+{
+    struct x11drv_win_data *data;
+
+    pthread_once( &damage_once, init_client_surface_damage );
+    if (!damage_available || (!!surface->damage == !!enable)) return;
+    if (!(data = get_win_data( surface->client.hwnd ))) return;
+    if (enable)
+    {
+        /* Deliver completion to the window's event thread even when DXVK
+         * submits the present from a worker thread. */
+        XSync( gdi_display, False );
+        surface->damage = pXDamageCreate( data->display, surface->window, XDamageReportNonEmpty );
+        XSaveContext( data->display, surface->damage, damage_context, (char *)surface->client.hwnd );
+    }
+    else
+    {
+        XDeleteContext( data->display, surface->damage, damage_context );
+        X11DRV_expect_error( data->display, damage_error_handler, NULL );
+        pXDamageDestroy( data->display, surface->damage );
+        XSync( data->display, False );
+        X11DRV_check_error();
+        surface->damage = 0;
+    }
+    XFlush( data->display );
+    release_win_data( data );
+}
+#else
+static void client_surface_set_damage( struct x11drv_client_surface *surface, BOOL enable ) {}
+#endif
